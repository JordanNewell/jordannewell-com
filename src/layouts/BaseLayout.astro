---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import { SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  schema?: object[];
  path?: string;
  ogImage?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  schema = [],
  path = Astro.url.pathname,
  ogImage,
} = Astro.props;

const ogTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith("http") ? ogImage : `${SITE.url}${ogImage}`)
  : `${SITE.url}/og-card.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="license" href="https://creativecommons.org/licenses/by-nc/4.0/" />
    <meta name="copyright" content="© 2026 Jordan Newell. CC BY-NC 4.0." />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" type="application/json" title={SITE.title} href="/feed.json" />
    <SchemaOrg schema={schema} />
    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "012b8a7bc7594c91aff6f05cab5951fd"}'></script>
  </head>
  <body>
    <div class="relative z-1">
      <Header path={path} />
      <main class="max-w-prose mx-auto px-5 py-12">
        <slot />
      </main>
      <Footer />
    </div>
    <a href="/" class="corner-badge" aria-label="Jordan Newell — home">
      <img src="/images/newell-mark.png" alt="" width="56" height="56" />
    </a>
    <style>
      .corner-badge {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 50;
        line-height: 0;
        opacity: 0.9;
        transition: opacity 0.15s, transform 0.15s;
      }
      .corner-badge img { width: 56px; height: 56px; border-radius: 10px; }
      .corner-badge:hover { opacity: 1; transform: translateY(-2px); }
      @media (max-width: 560px) {
        .corner-badge { right: 12px; bottom: 12px; }
        .corner-badge img { width: 44px; height: 44px; }
      }
    </style>
    <script src="/js/main.js" defer></script>
  </body>
</html>
