---
import BaseLayout from "./BaseLayout.astro";
import { softwareApplicationSchema } from "../lib/schema";
import { getCollection, type CollectionEntry } from "astro:content";

const { product } = Astro.props as { product: CollectionEntry<"products"> };
const {
  title,
  tagline,
  description,
  status,
  repo,
  homepage,
  logo,
  platform,
  shipDate,
  install,
  pricing,
  license,
  stats,
  features,
  comparison,
  faq,
  privacy,
  ogImage,
} = product.data;

const canonicalOg = ogImage ?? `/og-curtis-ai-chat.png`;

const statusColors: Record<string, string> = {
  released: "#0E8A4A",
  beta: "#B45309",
  preview: "#7A7683",
};

const schema = [
  softwareApplicationSchema({
    name: title,
    description,
    slug: product.id,
    repo,
    homepage,
    license,
    shipDate,
    pricing,
    faq,
  }),
];
---

<BaseLayout title={title} description={description} schema={schema} ogImage={canonicalOg}>
  <article class="product">
    <header class="page-head">
      <div class="ph-titlerow">
        <div class="ph-titlegroup">
          {logo && (
            <img src={`${logo}?v=11`} alt="" class="ph-logo" width="40" height="40" loading="eager" />
          )}
          <h1 class="ph-title">{title}</h1>
        </div>
        <p class="ph-stats">
          <span class="stat-n" style={`color: ${statusColors[status] ?? "#7A7683"}`}>{status}</span>
          {platform && <> · <a href={platform.url} target="_blank" rel="noopener" class="ph-stat-link">{platform.name.toLowerCase()} ↗</a></>}
          · {license}
          · shipped {shipDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}
        </p>
      </div>
      <p class="ph-tag">{tagline}</p>
      <p class="ph-desc">{description}</p>
      <p class="ph-links">
        {install.filter((i) => i.kind === "directory" || i.kind === "brat" || i.kind === "npm" || i.kind === "pip").slice(0, 1).map((i) => (
          <a href={i.href ?? repo} target="_blank" rel="noopener">install {i.label} ↗</a>
        ))}
        <a href={repo} target="_blank" rel="noopener">source ↗</a>
        {homepage && <a href={homepage} target="_blank" rel="noopener">homepage ↗</a>}
      </p>
      {stats.length > 0 && (
        <p class="ph-stats-row">
          {stats.map((s) => (
            <span class="ph-stat-pair"><span class="stat-n">{s.v}</span> {s.k}</span>
          ))}
        </p>
      )}
    </header>

    <!-- BODY (custom markdown from content) -->
    <div class="product-body prose">
      <slot />
    </div>

    {install.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Install</h2>
        <div class="ledger">
          {install.map((i) => (
            <div class="ledger-row">
              <span class="lg-name-sm">{i.label}</span>
              {i.href ? (
                <a href={i.href} target="_blank" rel="noopener" class="lg-link-sm">
                  {i.detail ?? i.href.replace(/^https?:\/\//, "").replace(/\/$/, "")} ↗
                </a>
              ) : (
                <span class="lg-link-sm lg-muted">{i.detail}</span>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {features.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Features</h2>
        <div class="ledger">
          {features.map((f) => (
            <div class="ledger-row feature-row">
              <span class="lg-name-sm">{f.icon ? `${f.icon} ` : ""}{f.title}</span>
              <span class="lg-desc-sm">
                {f.body}
                {f.docUrl && (<a href={f.docUrl} target="_blank" rel="noopener" class="doc-link">learn more ↗</a>)}
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    {comparison && (
      <section class="ledger-section">
        <h2 class="section-h">{comparison.title ?? "How it compares"}</h2>
        <div class="table-wrap">
          <table class="comparison-table">
            <thead>
              <tr>
                <th></th>
                {comparison.columns.map((c) => <th>{c}</th>)}
              </tr>
            </thead>
            <tbody>
              {comparison.rows.map((row) => (
                <tr>
                  <td class="row-label">{row.label}</td>
                  {row.cells.map((cell) => <td>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {privacy && (
      <section class="ledger-section">
        <h2 class="section-h">Privacy</h2>
        <p class="privacy-body">{privacy}</p>
      </section>
    )}

    {faq.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">FAQ</h2>
        <div class="ledger">
          {faq.map((item) => (
            <div class="ledger-row faq-row">
              <span class="lg-name-sm">{item.q}</span>
              <span class="lg-desc-sm">{item.a}</span>
            </div>
          ))}
        </div>
      </section>
    )}

  </article>
</BaseLayout>

<style>
  .product {
    max-width: 60rem;
    margin-inline: auto;
  }

  .page-head { margin-bottom: 2.25rem; }
  .ph-titlerow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 0.5rem;
    margin-bottom: 0.8rem;
  }
  .ph-titlegroup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ph-logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .ph-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }
  .ph-stats {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .stat-n { color: var(--color-fg); font-weight: 600; }
  .ph-stat-link { color: var(--color-fg-muted); }
  .ph-tag {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--color-fg-secondary);
    margin-bottom: 0.4rem;
  }
  .ph-desc {
    font-size: 0.92rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
    max-width: 65ch;
    margin-bottom: 1rem;
  }
  .ph-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .ph-links a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ph-links a:hover { color: color-mix(in srgb, var(--color-accent) 82%, #10143A); }
  .ph-stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .product-body { margin-bottom: 3rem; }

  .ledger-section { margin-bottom: 3rem; }
  .section-h {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-fg-muted);
    margin-bottom: 0.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule-strong);
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0 18px;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }
  .lg-name-sm {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    color: var(--color-fg);
  }
  .lg-link-sm {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-green);
    text-decoration: none;
    word-break: break-all;
  }
  .lg-link-sm:hover { text-decoration: underline; text-underline-offset: 3px; }
  .lg-muted { color: var(--color-fg-muted); }
  .lg-desc-sm {
    font-size: 0.9rem;
    color: var(--color-fg-secondary);
    line-height: 1.55;
  }
  .doc-link {
    display: inline-block;
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
  }
  .feature-row { grid-template-columns: 220px 1fr; }
  .faq-row { grid-template-columns: 260px 1fr; }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .comparison-table th,
  .comparison-table td {
    padding: 0.625rem 0.875rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }
  .comparison-table th {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
  }
  .comparison-table td:not(.row-label) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-fg-secondary);
  }
  .row-label { color: var(--color-fg); font-weight: 500; }

  .privacy-body {
    color: var(--color-fg-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
    padding-block: 0.9rem;
    border-left: 2px solid var(--color-fg);
    padding-left: 1.25rem;
  }

  @media (max-width: 640px) {
    .ledger-row, .feature-row, .faq-row { grid-template-columns: 1fr; row-gap: 0.25rem; }
  }
</style>
