---
import BaseLayout from "../layouts/BaseLayout.astro";
import { organizationSchema } from "../lib/schema";

const dwTrim = organizationSchema({
  name: "DW Trim",
  url: "https://dwtrimco.com",
  description: "Carpentry company scaling past greater Tampa Bay. Principal craftsman owns the trade; managing partner owns the backend.",
  employeeRole: "Managing Partner",
});

const schema = [dwTrim];
---

<BaseLayout title="Ventures" description="Operating roles with real stake — not advisory, not passive." schema={schema}>
  <h1 class="sr-only">Ventures</h1>
  <p class="ph-stats">
    <span class="stat-n">1</span> active · <span class="stat-n">0</span> advisory · <span class="stat-n">0</span> passive · Tampa Bay FL
  </p>

  <div class="ledger">
    <div class="ledger-head">
      <span>venture</span><span>role</span><span>notes</span>
    </div>
    <div class="ledger-row">
      <span class="lg-name">
        <a href="https://dwtrimco.com" target="_blank" rel="noopener" class="lg-link">DW Trim ↗</a>
      </span>
      <span class="lg-role">Managing Partner</span>
      <span class="lg-notes">
        <p class="note">Carpentry company operating in the greater Tampa Bay area. Dante Woodson owns the trade and serves as principal craftsman; I joined as Managing Partner to own the backend — operations, tech stack, the scaling playbook.</p>
        <p class="note">We are explicit about who is the senior in the craft and who is the senior in growth. Dante trains and oversees; I build the systems that let the craft scale.</p>
        <p class="note">Prior: NewellsWork — B2B turnkey contractor services, project management, estimation and bidding. Half-dead now, but the playbook (and the scars) carried forward.</p>
        <p class="note">Strategic bet: prove the scaling playbook on DW Trim's proven craft business with existing customer base, then springboard follow-on ventures.</p>
      </span>
    </div>
  </div>
</BaseLayout>

<style>
  .ph-stats {
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
  }
  .stat-n { color: var(--color-fg); font-weight: 600; }

  .ledger-head, .ledger-row {
    display: grid;
    grid-template-columns: 1fr 0.7fr 2.2fr;
    gap: 16px;
    align-items: baseline;
  }
  .ledger-head {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--color-rule-strong);
  }
  .ledger-row {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }
  .lg-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .lg-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lg-role {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
  }
  .lg-notes .note {
    font-size: 0.92rem;
    color: var(--color-fg-secondary);
    line-height: 1.55;
    margin-bottom: 0.6rem;
  }
  .lg-notes .note:last-child { margin-bottom: 0; }
  @media (max-width: 640px) {
    .ledger-head { display: none; }
    .ledger-row { grid-template-columns: 1fr; row-gap: 0.35rem; }
  }
</style>
