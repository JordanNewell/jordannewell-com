---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { PRODUCT_STATUS_COLORS } from "../../lib/site";

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);

const statusColors = PRODUCT_STATUS_COLORS;
---

<BaseLayout title="Products" description="Polished software Jordan Newell ships and stands behind." ogImage="/og-products.png">
  <h1 class="sr-only">Products</h1>

  <div class="ledger">
    <div class="ledger-head">
      <span></span><span>product</span><span>status</span><span>what it is</span>
    </div>
    {products.map((p) => (
      <a href={`/products/${p.id}/`} class="ledger-row">
        <span class="lg-logo-cell">
          {p.data.logo && !p.data.logoLight && <img src={`${p.data.logo}?v=11`} alt="" width="18" height="18" class="lg-logo" loading="lazy" />}
          {p.data.logo && p.data.logoLight && (
            <>
              <img src={`${p.data.logo}?v=11`} alt="" width="18" height="18" class="lg-logo lg-logo-dark" loading="lazy" />
              <img src={`${p.data.logoLight}?v=11`} alt="" width="18" height="18" class="lg-logo lg-logo-light" loading="lazy" />
            </>
          )}
        </span>
        <span class="lg-name">{p.data.title}</span>
        <span
          class="lg-st"
          style={`color: ${statusColors[p.data.status] ?? "#7A7683"}`}
        >
          {p.data.status}
        </span>
        <span class="lg-desc">{p.data.description}</span>
      </a>
    ))}
    {products.length === 0 && (
      <p class="text-[0.92rem] text-fg-muted italic">No products listed yet — check back soon.</p>
    )}
  </div>
</BaseLayout>

<style>
  /* Grid + spacing are products-specific; base ledger styles live in global.css */
  .ledger-head, .ledger-row {
    display: grid;
    grid-template-columns: 26px minmax(0, 1.1fr) auto minmax(0, 1.7fr);
    gap: 14px;
    align-items: baseline;
  }
  .ledger-row {
    padding-block: 0.85rem;
    text-decoration: none;
  }
  .lg-logo-cell {
    display: flex;
    align-items: center;
  }
  .lg-logo {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    display: block;
  }
  .lg-logo-light { display: none; }
  :global([data-theme="dark"]) .lg-logo-dark { display: none; }
  :global([data-theme="dark"]) .lg-logo-light { display: block; }
  .lg-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    transition: color 0.15s ease;
  }
  .ledger-row:hover .lg-name {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lg-st {
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .ledger-head { display: none; }
    .ledger-row {
      grid-template-columns: 26px 1fr auto;
      row-gap: 0.3rem;
    }
    .lg-desc { grid-column: 1 / -1; }
  }
</style>
