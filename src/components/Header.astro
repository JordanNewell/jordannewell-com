---
import { NAV_LINKS } from "../lib/site";
const { path } = Astro.props;
---

<header>
  <div class="header-inner max-w-prose mx-auto px-5 py-3.5 flex flex-wrap items-center gap-x-4 gap-y-2">
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle day/night">
      <svg viewBox="0 0 14 20" width="12" height="17" fill="none" aria-hidden="true">
        <rect x="1.25" y="1.25" width="11.5" height="17.5" rx="2.5" stroke="currentColor" stroke-width="1.5" />
        <rect class="switch-nub" x="4.5" y="3.75" width="5" height="4.5" rx="1.25" fill="currentColor" />
      </svg>
    </button>
    <nav class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[0.72rem]">
      {NAV_LINKS.map((link, i) => (
        <>
          {i > 0 && <span class="text-accent" aria-hidden="true">|</span>}
          <a
            href={link.href}
            class={`font-mono transition-colors whitespace-nowrap ${
              path === link.href ? "text-accent" : "text-fg-muted hover:text-fg"
            }`}
          >
            {link.label}
          </a>
        </>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Mobile: raise tap targets to the 40px comfort floor and legible font size.
     Desktop (>640px) is untouched. */
  @media (max-width: 640px) {
    .header-inner {
      padding-block: 0.125rem;
    }
    nav {
      font-size: 0.8125rem;
      gap: 0.25rem 0.5rem;
    }
    nav a {
      display: inline-block;
      padding-block: 0.75rem;
    }
  }
  .theme-toggle {
    margin-right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1;
    color: var(--color-fg-muted);
    background: none;
    border: none;
    padding: 0.375rem 0.25rem;
    cursor: pointer;
    transition: color 0.15s;
  }
  .theme-toggle:hover { color: var(--color-fg); }
  /* Light switch: nub up = day, nub flips down = night */
  .switch-nub { transition: transform 0.15s ease; }
  :global([data-theme="dark"]) .switch-nub { transform: translateY(7.75px); }
</style>

<script>
  const btn = document.getElementById("theme-toggle")!;
  btn.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>
