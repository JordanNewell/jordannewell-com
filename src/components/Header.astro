---
import { NAV_LINKS } from "../lib/site";
const { path } = Astro.props;
---

<header class="border-b border-border bg-bg/80 backdrop-blur-sm sticky top-0 z-10">
  <div class="max-w-prose mx-auto px-5 py-3.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <nav class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-[0.72rem]">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class={`font-mono transition-colors whitespace-nowrap ${
            path === link.href ? "text-accent" : "text-fg-muted hover:text-fg"
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
