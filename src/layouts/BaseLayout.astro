---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import { SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  schema?: object[];
  path?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  schema = [],
  path = Astro.url.pathname,
  ogImage,
  ogType = "website",
  noindex = false,
} = Astro.props;

const canonical = Astro.url.href;
// Brand the title only while the whole thing fits a SERP line (~60 chars);
// long post titles stand alone rather than truncating mid-sentence.
const brandSuffix = ` — ${SITE.title}`;
const ogTitle =
  title === SITE.title || title.length + brandSuffix.length > 60
    ? title
    : `${title}${brandSuffix}`;
// Meta descriptions clip past ~160 chars in search results anyway; the full
// text still ships in the page body and JSON-LD.
const metaDescription =
  description.length > 160 ? `${description.slice(0, 157).trimEnd()}…` : description;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith("http") ? ogImage : `${SITE.url}${ogImage}`)
  : `${SITE.url}/og-card.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Set theme before first paint to avoid a flash of the wrong palette.
      const stored = localStorage.getItem("theme");
      document.documentElement.dataset.theme =
        stored === "dark" || stored === "light"
          ? stored
          : matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ogTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#7CFC00" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="license" href="https://creativecommons.org/licenses/by-nc/4.0/" />
    <meta name="copyright" content="© 2026 Jordan Newell. CC BY-NC 4.0." />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" type="application/json" title={SITE.title} href="/feed.json" />
    <SchemaOrg schema={schema} />
    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "012b8a7bc7594c91aff6f05cab5951fd"}'></script>
  </head>
  <body>
    <div class="relative z-1">
      <Header path={path} />
      <a href="/" class="under-header-character max-w-prose mx-auto px-5" aria-label="Jordan Newell — home">
        <img src="/images/jordan-character.svg" alt="" width="380" height="435" />
        <img src="/images/jordan-character-dark.png" alt="" width="277" height="453" class="character-dark" />
      </a>
      <main class="max-w-prose mx-auto px-5 py-12">
        <slot />
      </main>
      <Footer mt={path === "/" ? "mt-12" : "mt-24"} />
    </div>
    <style>
      .under-header-character {
        display: flex;
        justify-content: flex-end;
        padding-top: 14px;
        line-height: 0;
        opacity: 0.9;
        transition: opacity 0.15s;
      }
      .under-header-character img { width: 132px; height: auto; }
      .under-header-character:hover { opacity: 1; }
      .character-dark { display: none; }
      /* Dark art is tighter-cropped than the light SVG — match rendered
         HEIGHT (132px-wide light SVG renders ~151px tall), not width. */
      :global([data-theme="dark"]) .under-header-character .character-dark {
        display: block;
        width: auto;
        height: 151px;
        margin-left: -35px;
      }
      :global([data-theme="dark"]) .under-header-character img:not(.character-dark) { display: none; }
      @media (max-width: 560px) {
        .under-header-character img { width: 96px; height: auto; }
        :global([data-theme="dark"]) .under-header-character .character-dark { width: auto; height: 110px; margin-left: -29px; }
      }
    </style>
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "960ac9db0dd14902b6cfe31e6b2e7fd1"}'></script>
  </body>

</html>
