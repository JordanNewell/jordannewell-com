---
import BaseLayout from "../layouts/BaseLayout.astro";
import { personSchema } from "../lib/schema";
import { SITE } from "../lib/site";

const schema = [personSchema()];
---

<BaseLayout title="About" description="Operator shipping in public across sectors." schema={schema} ogImage="/og-about.png">
  <article class="prose">
    <h1 class="sr-only">About Jordan Newell</h1>
    <p>
      Software takes the front seat — projects shipped into the world, built on
      a self-hosted fleet of AI agents running around the clock, plus the
      infrastructure behind mail, status pages, and sites for businesses across
      different spectrums.
    </p>
    <p>
      <strong>Field notes from an operator shipping in public across sectors.</strong><br />
      Notes, post-mortems, the occasional manifesto.
    </p>
  </article>
</BaseLayout>
