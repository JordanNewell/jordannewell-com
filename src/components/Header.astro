---
import { NAV_LINKS } from "../lib/site";
const { path } = Astro.props;
---

<header>
  <div class="header-inner max-w-prose mx-auto px-5 py-3.5 flex flex-wrap items-center gap-x-4 gap-y-2">
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle day/night">
      <span class="switch3d" aria-hidden="true">
        <span class="rocker"></span>
        <span class="led"></span>
      </span>
    </button>
    <nav class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[0.72rem]">
      {NAV_LINKS.map((link, i) => (
        <>
          {i > 0 && <span class="text-green" aria-hidden="true">|</span>}
          <a
            href={link.href}
            class={`font-mono transition-colors whitespace-nowrap ${
              path === link.href ? "text-green" : "text-fg-muted hover:text-fg"
            }`}
          >
            {link.label}
          </a>
        </>
      ))}
    </nav>
    <!-- Watch/listen tiles — cartoon TV + mic, centered over the character's
         head (absolute: the character's center sits ~86px from the container's
         right edge in both themes, ~68px on mobile). Same plate/LED treatment
         as the light switch so they read as one hardware family. -->
    <div class="watch-listen">
      <a href="https://www.youtube.com/@newellops" aria-label="YouTube" title="YouTube" target="_blank" rel="noopener">
        <svg width="27" height="22" viewBox="0 0 27 22" aria-hidden="true">
          <path class="tile-accent" d="M8.5 6 4.5 1.5M18.5 6l4-4.5" stroke-width="1.6" stroke-linecap="round" />
          <rect x="1" y="5" width="25" height="16" rx="3.5" fill="#1a1a1e" stroke="#3a3a40" />
          <rect class="tile-fill" x="4" y="8" width="13.5" height="10" rx="1.5" />
          <circle class="tile-accent-fill" cx="21.2" cy="10.8" r="1.7" />
          <circle cx="21.2" cy="16.2" r="1.7" fill="#55555c" />
        </svg>
      </a>
      <a href="/podcast" aria-label="The Standup — podcast" title="The Standup — podcast">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <rect x="1" y="1" width="20" height="20" rx="6" fill="#1a1a1e" stroke="#3a3a40" />
          <rect class="tile-fill" x="8" y="4.5" width="6" height="8" rx="3" />
          <path class="tile-accent" d="M6 10.5a5 5 0 0 0 10 0" stroke-width="1.6" fill="none" stroke-linecap="round" />
          <path class="tile-accent" d="M11 15.5v3" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  /* Watch/listen tiles — dark plates + green fills, lifted out of the flex
     flow so they hover over the character's head without affecting header
     height. The character's center lands ~86px from the container's right
     edge in both themes (light: 20px pad + 66px half-width; dark: 20px pad
     + 46px half-width + 20px translate), ~68px once the character shrinks
     at 560px. translate(50%,…) centers the group on that point. */
  .header-inner {
    position: relative;
    /* Watch/listen color schedule — day: green; night: white. Same schedule
       the switch rocker follows below. */
    --wl-main: #0E8A4A;
    --wl-accent: #3ddc74;
    --wl-hover: #17c964;
  }
  :global([data-theme="dark"]) .header-inner {
    --wl-main: #ffffff;
    --wl-accent: #ffffff;
    --wl-hover: #d9d9d9;
  }
  .watch-listen {
    position: absolute;
    right: 86px;
    top: 50%;
    transform: translate(50%, -50%);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .watch-listen a {
    display: inline-flex;
    line-height: 0;
    padding: 9px 8px;
    transition: transform 0.15s;
  }
  .watch-listen a:hover { transform: translateY(-1px); }
  .tile-fill { fill: var(--wl-main); transition: fill 0.15s; }
  .tile-accent { stroke: var(--wl-accent); transition: stroke 0.15s; }
  .tile-accent-fill { fill: var(--wl-accent); transition: fill 0.15s; }
  .watch-listen a:hover .tile-fill { fill: var(--wl-hover); }
  .watch-listen a:hover .tile-accent { stroke: var(--wl-hover); }
  .watch-listen a:hover .tile-accent-fill { fill: var(--wl-hover); }
  /* Mobile: raise tap targets to the 40px comfort floor and legible font size.
     Desktop (>640px) is untouched. */
  @media (max-width: 640px) {
    .header-inner {
      padding-block: 0.125rem;
    }
    nav {
      font-size: 0.8125rem;
      gap: 0.25rem 0.5rem;
    }
    nav a {
      display: inline-block;
      padding-block: 0.75rem;
    }
  }
  /* Character shrinks at 560px — follow its head. */
  @media (max-width: 560px) {
    .watch-listen {
      right: 68px;
    }
  }
  .theme-toggle {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1;
    color: var(--color-fg-muted);
    background: none;
    border: none;
    padding: 0.375rem 0.25rem;
    cursor: pointer;
    transition: color 0.15s;
  }
  .theme-toggle:hover { color: var(--color-fg); }
  /* B/W light switch — rocker physically flips on its X axis.
     Day: bottom pressed in (lights on, LED lit). Night: top pressed in (off). */
  .switch3d {
    position: relative;
    display: inline-block;
    width: 19px;
    height: 31px;
    padding: 3px 3.5px 5.5px;
    background: #111114;
    border-radius: 4px;
    border: 1px solid #2a2a2e;
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.7),
      0 1px 0 rgba(255, 255, 255, 0.12);
    perspective: 80px;
  }
  /* plate screws, top + bottom — like a real wall plate */
  .switch3d::before,
  .switch3d::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 3px;
    height: 3px;
    margin-left: -1.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #4a4a50, #1c1c20);
  }
  .switch3d::before { top: 1px; }
  .switch3d::after { bottom: 1px; }
  .rocker {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 2px;
    /* day: lights on, green rocker (same schedule as the watch/listen tiles) */
    background: linear-gradient(#3ddc74, #0E8A4A);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.55),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12);
    transform: rotateX(24deg);
    transform-style: preserve-3d;
    /* spring: flips past the settle point, then rocks back */
    transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.15s;
  }
  .theme-toggle:hover .rocker { background: linear-gradient(#3ddc74, #17c964); }
  .led {
    position: absolute;
    left: 50%;
    bottom: 4.5px;
    width: 2px;
    height: 2px;
    margin-left: -1px;
    border-radius: 50%;
    /* lights on: green pilot lit */
    background: #3ddc74;
    box-shadow: 0 0 3px 1px rgba(61, 220, 116, 0.6);
    transition: opacity 0.2s, box-shadow 0.2s;
  }
  :global([data-theme="dark"]) .rocker {
    transform: rotateX(-24deg);
    /* night: lights off, white rocker */
    background: linear-gradient(#ffffff, #d9d9d9);
    box-shadow:
      0 -1px 1px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  :global([data-theme="dark"]) .theme-toggle:hover .rocker {
    background: linear-gradient(#ffffff, #e6e6e6);
  }
  :global([data-theme="dark"]) .led {
    /* lights off */
    background: #333;
    box-shadow: none;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle")!;
  btn.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>
