---
import { NAV_LINKS } from "../lib/site";
const { path } = Astro.props;
---

<header>
  <div class="header-inner relative max-w-prose mx-auto px-5 py-3.5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
    <button id="theme-toggle" class="theme-toggle absolute left-[50px]" type="button" aria-label="Toggle day/night">
      <span class="switch3d" aria-hidden="true">
        <span class="rocker"></span>
        <span class="led"></span>
      </span>
    </button>
    <nav class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[0.72rem]">
      {NAV_LINKS.map((link, i) => (
        <>
          {i > 0 && <span class="text-green" aria-hidden="true">·</span>}
          <a
            href={link.href}
            class={`font-mono transition-colors whitespace-nowrap ${
              path === link.href ? "text-green" : "text-fg-muted hover:text-fg"
            }`}
          >
            {link.label}
          </a>
        </>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Mobile: raise tap targets to the 40px comfort floor and legible font size.
     Desktop (>640px) is untouched. */
  @media (max-width: 640px) {
    .header-inner {
      padding-block: 0.125rem;
    }
    nav {
      font-size: 0.8125rem;
      gap: 0.25rem 0.5rem;
    }
    nav a {
      display: inline-block;
      padding-block: 0.75rem;
    }
  }
  /* Desktop: pull the centered nav left to halve the gap to the switch */
  @media (min-width: 641px) {
    nav {
      transform: translateX(-85px);
    }
  }
  .theme-toggle {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1;
    color: var(--color-fg-muted);
    background: none;
    border: none;
    padding: 0.375rem 0.25rem;
    cursor: pointer;
    transition: color 0.15s;
  }
  .theme-toggle:hover { color: var(--color-fg); }
  /* B/W light switch — rocker physically flips on its X axis.
     Day: bottom pressed in (lights on, LED lit). Night: top pressed in (off). */
  .switch3d {
    position: relative;
    display: inline-block;
    width: 19px;
    height: 31px;
    padding: 3px 3.5px 5.5px;
    background: #111114;
    border-radius: 4px;
    border: 1px solid #2a2a2e;
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.7),
      0 1px 0 rgba(255, 255, 255, 0.12);
    perspective: 80px;
  }
  /* plate screws, top + bottom — like a real wall plate */
  .switch3d::before,
  .switch3d::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 3px;
    height: 3px;
    margin-left: -1.5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #4a4a50, #1c1c20);
  }
  .switch3d::before { top: 1px; }
  .switch3d::after { bottom: 1px; }
  .rocker {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(#ffffff, #d9d9d9);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.55),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12);
    transform: rotateX(24deg);
    transform-style: preserve-3d;
    /* spring: flips past the settle point, then rocks back */
    transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .theme-toggle:hover .rocker { background: linear-gradient(#ffffff, #e6e6e6); }
  .led {
    position: absolute;
    left: 50%;
    bottom: 4.5px;
    width: 2px;
    height: 2px;
    margin-left: -1px;
    border-radius: 50%;
    /* lights on: green pilot lit */
    background: #3ddc74;
    box-shadow: 0 0 3px 1px rgba(61, 220, 116, 0.6);
    transition: opacity 0.2s, box-shadow 0.2s;
  }
  :global([data-theme="dark"]) .rocker {
    transform: rotateX(-24deg);
    background: linear-gradient(#e9e9e9, #bdbdbd);
    box-shadow:
      0 -1px 1px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  :global([data-theme="dark"]) .led {
    /* lights off */
    background: #333;
    box-shadow: none;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle")!;
  btn.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>
