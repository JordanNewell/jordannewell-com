---
// PostShare — emoji-style like + share popup
// Trigger: 👍 emoji + label. Popup: emoji-labeled platform buttons.
// mailto: built client-side at click time to dodge Cloudflare email obfuscation.

interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

// email parts stored SEPARATELY so CF doesn't see a mailto: href in the HTML
const emailSubject = title;
const emailBody = url;

const platforms = [
  { id: "x", label: "X", emoji: "🐦", href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}` },
  { id: "linkedin", label: "LinkedIn", emoji: "💼", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  { id: "hn", label: "HN", emoji: "🟧", href: `https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${encodedTitle}` },
  { id: "reddit", label: "Reddit", emoji: "👽", href: `https://reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}` },
];
---

<div class="post-share" data-share-root data-share-url={url} data-share-title={title} data-email-subject={emailSubject} data-email-body={emailBody}>
  <button
    class="share-btn"
    type="button"
    aria-label="Like and share this post"
    aria-haspopup="true"
    aria-expanded="false"
    data-share-btn
  >
    <span class="share-emoji" aria-hidden="true">👍</span>
    <span class="share-count" data-share-count aria-live="polite">0</span>
  </button>

  <div class="share-popup" data-share-popup hidden>
    <div class="share-popup-arrow" aria-hidden="true"></div>
    <div class="share-popup-header">
      <span>pass it along</span>
      <button class="share-close" type="button" aria-label="Close" data-share-close>×</button>
    </div>
    <div class="share-grid">
      {platforms.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener"
          class="share-platform"
          aria-label={`Share to ${p.label}`}
          data-platform={p.id}
        >
          <span class="share-platform-emoji" aria-hidden="true">{p.emoji}</span>
          <span class="share-platform-text">{p.label}</span>
        </a>
      ))}
      <a
        href="#"
        class="share-platform share-email"
        aria-label="Share via email"
        data-platform="email"
      >
        <span class="share-platform-emoji" aria-hidden="true">✉️</span>
        <span class="share-platform-text">Email</span>
      </a>
      <button
        class="share-platform share-copy"
        type="button"
        aria-label="Copy link"
        data-share-copy
        data-copy-url={url}
      >
        <span class="share-platform-emoji" aria-hidden="true">🔗</span>
        <span class="share-platform-text" data-copy-label>Copy</span>
      </button>
    </div>
  </div>
</div>

<style>
  .post-share {
    position: relative;
    margin: 56px 0 24px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: center;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--fg-secondary);
    padding: 12px 24px;
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .share-btn:hover {
    border-color: var(--border-light);
    color: var(--fg);
    background: var(--bg-card);
  }
  .share-btn:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 2px;
  }
  .share-btn.liked {
    border-color: rgba(52, 211, 153, 0.5);
    background: rgba(52, 211, 153, 0.08);
    color: var(--fg);
  }

  .share-emoji {
    font-size: 1.6rem;
    line-height: 1;
    display: inline-block;
    transform-origin: 50% 70%;
    transition: transform 0.15s ease;
    /* Tint the emoji solid green (preserves shape, strips original color) */
    filter:
      brightness(0)
      saturate(100%)
      invert(64%) sepia(87%) saturate(410%) hue-rotate(108deg)
      brightness(96%) contrast(92%)
      drop-shadow(0 0 6px rgba(52, 211, 153, 0.5));
  }
  .share-btn:not(.liked) .share-emoji {
    opacity: 0.85;
  }
  .share-btn.liked .share-emoji {
    opacity: 1;
  }

  .share-count {
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
    transition: color 0.15s;
    min-width: 1ch;
    text-align: right;
  }
  .share-btn.liked .share-count {
    color: var(--color-green);
  }
  .share-count.bumped {
    animation: count-bump 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes count-bump {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.4); }
    100% { transform: scale(1); }
  }

  /* Idle wiggle — every 5s a tiny shake to telegraph interactivity */
  @keyframes idle-wiggle {
    0%, 92%, 100% { transform: rotate(0deg); }
    94% { transform: rotate(-8deg); }
    96% { transform: rotate(6deg); }
    98% { transform: rotate(-2deg); }
  }
  .share-emoji {
    animation: idle-wiggle 5s ease-in-out infinite;
  }

  /* Click bounce */
  @keyframes share-bounce {
    0%   { transform: scale(1) rotate(0deg); }
    20%  { transform: scale(1.4) rotate(-18deg); }
    40%  { transform: scale(0.85) rotate(12deg); }
    60%  { transform: scale(1.15) rotate(-5deg); }
    80%  { transform: scale(0.97) rotate(2deg); }
    100% { transform: scale(1) rotate(0deg); }
  }
  .share-btn.bouncing .share-emoji {
    animation: share-bounce 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .share-popup {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #111113;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 14px;
    min-width: 280px;
    box-shadow: 0 10px 36px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(52, 211, 153, 0.08);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    z-index: 20;
  }
  .share-popup.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .share-popup[hidden] {
    display: none;
  }

  .share-popup-arrow {
    position: absolute;
    bottom: -7px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 12px;
    height: 12px;
    background: #111113;
    border-right: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .share-popup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding: 0 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--fg-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .share-close {
    background: transparent;
    border: none;
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    padding: 2px 7px;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .share-close:hover {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.06);
  }

  .share-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }

  .share-platform {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 14px 8px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
    color: var(--fg-secondary);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: background 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
  }
  .share-platform:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border-light);
    transform: translateY(-1px);
  }
  .share-platform-emoji {
    font-size: 1.5rem;
    line-height: 1;
  }
  .share-copy {
    width: 100%;
    border: none;
  }
  .share-copy.copied {
    background: rgba(52, 211, 153, 0.12);
    border-color: rgba(52, 211, 153, 0.3);
    color: #34d399;
  }

  @media (max-width: 480px) {
    .share-btn {
      padding: 8px 16px;
    }
    .share-emoji {
      font-size: 1.5rem;
    }
  }

  /* Mobile: popup becomes centered overlay (no clipping by containers) */
  @media (max-width: 640px) {
    .share-popup {
      position: fixed;
      bottom: auto;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.95);
      min-width: 0;
      width: calc(100vw - 2rem);
      max-width: 340px;
    }
    .share-popup.open {
      transform: translate(-50%, -50%) scale(1);
    }
    .share-popup-arrow {
      display: none;
    }
  }
</style>

<script is:inline src="/js/post-share.js" defer></script>
