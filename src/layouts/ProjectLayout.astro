---
import BaseLayout from "./BaseLayout.astro";
import TagPill from "../components/TagPill.astro";
import { creativeWorkSchema } from "../lib/schema";
import { getCollection, type CollectionEntry } from "astro:content";
import { existsSync } from "node:fs";

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { title, description, status, repo, liveUrl, pkg, tags } = project.data;

const pkgLabel = (url: string): string => {
  try {
    const host = new URL(url).hostname;
    if (host.includes("npmjs")) return "npm";
    if (host.includes("pypi.org")) return "pypi";
    if (host.includes("obsidian.md")) return "obsidian";
    if (host.includes("crates.io")) return "crates";
    return "pkg";
  } catch {
    return "pkg";
  }
};

// Share card: public/projects/<id>/card.png when present.
const cardOg = existsSync(`public/projects/${project.id}/card.png`)
  ? `/projects/${project.id}/card.png`
  : undefined;

const allPosts = await getCollection("posts");
const relatedPosts = allPosts
  .filter((p) => p.data.project === project.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// NOTE: intentionally different from /projects index statusColors — this detail
// view uses louder inks for exploratory/venture-track/deprecated. Do not merge.
const statusColors: Record<string, string> = {
  active: "#0E8A4A",
  shipped: "#1F4FD8",
  exploratory: "#B45309",
  "venture-track": "#6D28D9",
  deprecated: "#7A7683",
};

const schema = [
  creativeWorkSchema({
    name: title,
    description,
    slug: project.id,
    repo,
    status,
    tags,
  }),
];
---

<BaseLayout title={title} description={description} schema={schema} ogImage={cardOg}>
  <article class="prose">
    <header class="page-head">
      <div class="ph-titlerow">
        <h1 class="ph-title">{title}</h1>
        <p class="ph-stats">
          <span class="stat-n" style={`color: ${statusColors[status] ?? "#7A7683"}`}>{status}</span>
          {repo && <> · <a href={repo} target="_blank" rel="noopener" class="ph-stat-link">source ↗︎</a></>}
          {liveUrl && <> · <a href={liveUrl} target="_blank" rel="noopener" class="ph-stat-link">live ↗︎</a></>}
          {pkg && <> · <a href={pkg} target="_blank" rel="noopener" class="ph-stat-link">{pkgLabel(pkg)} ↗︎</a></>}
        </p>
      </div>
      <p class="ph-tag">{description}</p>
      {tags.length > 0 && (
        <p class="ph-tags">
          {tags.map((tag) => <TagPill tag={tag} />)}
        </p>
      )}
    </header>

    {project.data.facts && project.data.facts.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">At a glance</h2>
        <div class="facts-row">
          {project.data.facts.map((fact) => (
            <span class="fact-pair">
              <span class="stat-n">{fact.v}</span> {fact.k}
            </span>
          ))}
        </div>
      </section>
    )}

    {project.data.highlights && project.data.highlights.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Highlights</h2>
        <div>
          {project.data.highlights.map((h) => (
            <div class="ledger-row">
              <span class="lg-name-sm">{h.title}</span>
              <span class="lg-desc-sm">{h.body}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {project.data.stack && project.data.stack.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Stack</h2>
        <p class="stack-line">{project.data.stack.join(" · ")}</p>
      </section>
    )}

    <slot />

    {relatedPosts.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Related</h2>
        <div>
          {relatedPosts.map((p) => (
            <a href={`/posts/${p.id}/`} class="ledger-row rel-row">
              <span class="lg-name-sm">{p.data.title}</span>
              <span class="lg-date-sm">{p.data.pubDate.toISOString().slice(0, 10)}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  /* Shared header/section chrome lives in global.css; layout-specific bits below */
  .page-head { margin-bottom: 2rem; }
  .ph-titlerow {
    align-items: baseline;
  }
  .ph-stats {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ph-tag {
    margin-bottom: 0.5rem;
    max-width: 62ch;
  }
  .ph-tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .ledger-section { margin-bottom: 2.25rem; }
  .facts-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    padding-block: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0 18px;
    padding-block: 0.8rem;
    align-items: baseline;
  }
  .lg-date-sm {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-muted);
    text-align: right;
  }
  .rel-row { text-decoration: none; }
  .rel-row:hover .lg-name-sm {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .stack-line {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-fg-secondary);
    padding-block: 0.8rem;
  }

  @media (max-width: 640px) {
    .ledger-row { grid-template-columns: 1fr; row-gap: 0.25rem; }
    .lg-date-sm { text-align: left; }
  }
</style>
