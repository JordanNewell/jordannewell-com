---
import { existsSync } from "node:fs";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 1);

const heroFor = (id: string): string | null => {
  for (const ext of ["png", "jpg", "jpeg", "webp"]) {
    if (existsSync(`public/posts/${id}/hero.${ext}`)) return `/posts/${id}/hero.${ext}`;
  }
  return null;
};
---

<BaseLayout title="Jordan Newell" description="I build and operate the systems behind ambitious ventures." path="/">
  <div class="manifesto">
    <div class="mast-n-wrap">
      <img src="/images/newell-icon.png" alt="" width="1024" height="1024" class="mast-n" loading="eager" />
    </div>
    {posts.map((post) => {
      const hero = heroFor(post.id);
      return (
        <a href={`/posts/${post.id}/`} class="post-item">
          {hero ? (
            <span class="featured-cover">
              <img src={hero} alt="" width="1168" height="784" loading="eager" />
            </span>
          ) : null}
          <div class="post-meta">
            <span class="post-date">
              {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}
            </span>
            <span class="post-title">{post.data.title}</span>
          </div>
          <div class="read-this">read →</div>
        </a>
      );
    })}
  </div>

</BaseLayout>

<style>
  .manifesto {
    margin-block: 8px 72px;
  }
  .mast-n-wrap {
    display: flex;
    justify-content: center;
    /* main is py-12; pull the N up so it sits right under the header rule */
    margin-top: -2.5rem;
    margin-bottom: 32px;
  }
  .mast-n {
    width: 90px;
    height: auto;
  }
  .post-item {
    display: block;
    text-decoration: none;
  }
  .featured-cover {
    display: block;
    margin-bottom: 1.1rem;
  }
  .featured-cover img {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--color-border);
  }
  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .post-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.005em;
    line-height: 1.35;
    color: var(--color-fg);
    transition: color 0.15s;
  }
  .post-item:hover .post-title { color: var(--color-accent); }
  .read-this {
    margin-top: 0.6rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .post-item:hover .read-this { color: var(--color-accent); }
</style>
