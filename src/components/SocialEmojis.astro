---
// Bottom-of-page social emojis — coffee / sponsor / hello.
// Rendered at the foot of the splash, below the keyboard + key strip.
---

<div class="social-emojis">
  <a href="https://buymeacoffee.com/jordannewell" target="_blank" rel="noopener" class="social-emoji-link" aria-label="Buy me a coffee" title="Buy me a coffee">
    <span aria-hidden="true" class="emoji-coffee">☕</span>
  </a>
  <a href="mailto:hello@jordannewell.com" class="social-emoji-link" aria-label="Say hello" title="Say hello">
    <span aria-hidden="true">👋</span>
  </a>
  <a href="https://github.com/sponsors/JordanNewell" target="_blank" rel="noopener" class="social-emoji-link" aria-label="Sponsor on GitHub" title="Sponsor on GitHub">
    <span aria-hidden="true">🤍</span>
  </a>
</div>

<style>
  .social-emojis {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 20px;
  }
  .social-emoji-link {
    text-decoration: none;
    font-size: 22px;
    line-height: 1;
    opacity: 0.85;
    transition: opacity 0.15s ease, transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.18s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 36px;
    padding: 4px;
    cursor: pointer;
  }
  .social-emoji-link:hover {
    opacity: 1;
    transform: scale(1.35);
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--color-green) 35%, transparent));
  }
  .emoji-coffee {
    filter: sepia(1) saturate(4) hue-rotate(5deg) brightness(1.1);
  }
  @media (max-width: 600px) {
    .social-emojis { gap: 14px; }
    .social-emoji-link { font-size: 20px; min-width: 32px; min-height: 32px; }
  }
</style>
