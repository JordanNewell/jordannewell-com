---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { series } from "../../content/series";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const postCountBySeries = new Map<string, number>();
for (const post of posts) {
  for (const slug of post.data.series) {
    postCountBySeries.set(slug, (postCountBySeries.get(slug) ?? 0) + 1);
  }
}

const visibleSeries = series
  .filter((s) => (postCountBySeries.get(s.slug) ?? 0) > 0)
  .sort((a, b) => a.order - b.order);
---

<BaseLayout title="Series" description="Recurring content series: Off-Model (LLM sessions), Heritage (pre-fleet origin).">
  <div>
    <header class="mb-12">
      <h1 class="sr-only">Series</h1>
      <p class="text-fg-secondary">Thematic collections across the blog. Tool-themed, era-themed, or cross-cutting.</p>
    </header>
    {visibleSeries.length === 0 ? (
      <p class="text-fg-muted text-sm border border-dashed border-border rounded-lg p-5">
        No series active yet. Posts will populate series pages as they ship —
        see <a href="/posts/" class="text-accent hover:underline">/posts</a> for current writing.
      </p>
    ) : (
      <div class="space-y-4">
        {visibleSeries.map((s) => (
          <a href={`/series/${s.slug}/`} class="block py-4 group">
            <div class="flex items-baseline justify-between mb-1">
              <h2 class="font-display font-semibold text-[0.95rem] tracking-tight group-hover:text-accent group-hover:underline group-hover:underline-offset-4 transition-colors">{s.name}</h2>
              <span class="text-xs font-mono text-fg-muted">{postCountBySeries.get(s.slug)} posts</span>
            </div>
            <p class="text-fg-secondary text-sm">{s.description}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
