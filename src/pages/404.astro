---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Not Found" description="Page not found.">
  <header class="mb-10">
    <h1 class="sr-only">404 — Not Found</h1>
    <p class="text-fg-secondary">
      That URL doesn't go anywhere. Try the <a href="/" class="text-green hover:underline">homepage</a>,
      <a href="/now/" class="text-green hover:underline">now</a>, or
      <a href="/products/" class="text-green hover:underline">products</a>.
    </p>
  </header>
</BaseLayout>
