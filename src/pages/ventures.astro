---
import BaseLayout from "../layouts/BaseLayout.astro";
import { organizationSchema } from "../lib/schema";

const dwTrim = organizationSchema({
  name: "DW Trim",
  url: "https://dwtrimco.com",
  description: "Carpentry company serving central and south Florida. Principal craftsman owns the trade; managing partner runs the business side.",
  employeeRole: "Managing Partner",
});

const curtisAi = organizationSchema({
  name: "Curtis AI",
  url: "https://curtisai.tech",
  description:
    "The AI line: Curtis — the agent for Obsidian and ACP clients (53 providers, 12 vault tools, skills, the multi-model arena) — plus Curtis Porter, curtis-compliance, and the .curt portable history format. Source-available BUSL-1.1, free to use, no telemetry.",
  employeeRole: "Founder",
  pageUrl: "https://jordannewell.com/curtis/",
});

const onionbreath = organizationSchema({
  name: "Onionbreath",
  description: "Onion-themed food reseller migrating winners to private label. Luxury onion pipeline, field to mouth.",
  employeeRole: "Founder",
});

const schema = [dwTrim, curtisAi, onionbreath];
---

<BaseLayout title="Ventures" description="Operating roles and founder stakes — not advisory, not passive." schema={schema} ogImage="/og-ventures.png">
  <h1 class="sr-only">Ventures</h1>
  <p class="ph-stats">
    <span class="stat-n">3</span> active · <span class="stat-n">0</span> advisory · <span class="stat-n">0</span> passive
  </p>

  <div class="ledger">
    <div class="ledger-head">
      <span>venture</span><span>role</span><span>notes</span>
    </div>
    <div class="ledger-row">
      <span class="lg-name">
        <a href="/posts/dw-trim-anchor/" class="lg-link">DW Trim</a>
      </span>
      <span class="lg-role">Managing Partner</span>
      <span class="lg-notes">
        <p class="note">Carpentry company serving central and south Florida. Dante Woodson owns the trade; I run the business side — ops, tech, growth. Site: <a href="https://dwtrimco.com" target="_blank" rel="noopener">dwtrimco.com</a>. Story: <a href="/posts/dw-trim-anchor/">the anchor job</a>, now <a href="/posts/dw-trim-gearing-up/">underway</a>.</p>
      </span>
    </div>
    <div class="ledger-row">
      <span class="lg-name">
        <a href="/curtis" class="lg-link">Curtis AI</a>
      </span>
      <span class="lg-role">Founder</span>
      <span class="lg-notes">
        <p class="note">Local-first AI agents — the Curtis line, bound by portable .curt history you own. Source-available, free, no telemetry. The ledger and the receipts: <a href="/curtis">/curtis</a>.</p>
      </span>
    </div>
    <div class="ledger-row">
      <span class="lg-name">
        <a href="/posts/new-ventures-onionbreath/" class="lg-link">Onionbreath</a>
      </span>
      <span class="lg-role">Founder</span>
      <span class="lg-notes">
        <p class="note">Onion-themed food under the Onionbreath brand — resell first, watch what moves, migrate the movers to private label. The luxury onion pipeline, field to mouth. Store opening soon; the <a href="/posts/new-ventures-onionbreath/">story</a> is already up.</p>
      </span>
    </div>
  </div>
</BaseLayout>

<style>
  /* Grid + spacing are venture-specific; base ledger styles live in global.css */
  .ledger-head, .ledger-row {
    display: grid;
    grid-template-columns: 1fr 0.7fr 2.2fr;
    gap: 16px;
    align-items: baseline;
  }
  .ledger-row {
    padding-block: 0.9rem;
  }
  @media (max-width: 640px) {
    .ledger-head { display: none; }
    .ledger-row { grid-template-columns: 1fr; row-gap: 0.35rem; }
  }
</style>
