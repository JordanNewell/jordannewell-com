---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const episodes = (await getCollection("podcast"))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const totalMinutes = episodes.reduce((sum, e) => {
  const [m, s = "0"] = e.data.duration.split(":");
  return sum + Number(m) * 60 + Number(s);
}, 0);
---

<BaseLayout title="The Standup" description="The Standup reads this site's posts out loud — an ensemble of synthesized voices, generated from the blog. Same field notes, now audible." ogImage="/og-card.png">
  <h1 class="sr-only">The Standup</h1>
  <p class="ph-stats">
    <span class="stat-n">{episodes.length}</span> episodes · <span class="stat-n">{Math.round(totalMinutes / 60)}</span> min
  </p>

  <nav class="listen" aria-label="Listen on">
    <span class="listen-label">listen on</span>
    <a class="listen-pill" href="https://open.spotify.com/show/0APusThnqOeTmDwi5vPoVm" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <circle cx="12" cy="12" r="9.25" stroke-width="1.5" />
        <path d="M7.5 9.7c3.2-.9 6.4-.6 9 .9" stroke-width="1.6" stroke-linecap="round" />
        <path d="M8 12.6c2.6-.7 5.1-.4 7.3.8" stroke-width="1.5" stroke-linecap="round" />
        <path d="M8.5 15.3c2-.5 3.9-.3 5.6.6" stroke-width="1.4" stroke-linecap="round" />
      </svg>
      Spotify
    </a>
    <a class="listen-pill" href="https://music.amazon.com/podcasts/bfe95857-f001-4064-9e00-e1eac0d93f08/the-standup" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="4.5" stroke-width="1.5" />
        <path d="M7 14c3.2 1.8 6.8 1.8 10 0" stroke-width="1.5" stroke-linecap="round" />
        <path d="M17.3 13.2l.7 1.8-1.9.2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Amazon Music
    </a>
    <a class="listen-pill" href="https://pca.st/royoyi2l" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <circle cx="12" cy="12" r="9.25" stroke-width="1.5" />
        <path d="M12 7.5a4.5 4.5 0 1 1-4.5 4.5" stroke-width="1.5" stroke-linecap="round" />
        <path d="M12 9.9a2.1 2.1 0 1 1-2.1 2.1" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none" />
      </svg>
      Pocket Casts
    </a>
    <a class="listen-pill" href="/podcast/feed.xml">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path d="M5.5 11.5a7 7 0 0 1 7 7" stroke-width="1.8" stroke-linecap="round" />
        <path d="M5.5 5.5a13 13 0 0 1 13 13" stroke-width="1.8" stroke-linecap="round" />
        <circle cx="6.2" cy="17.8" r="1.4" fill="currentColor" stroke="none" />
      </svg>
      RSS
    </a>
  </nav>

  {episodes.length === 0 ? (
    <p class="lg-desc">No episodes yet. The blog comes first; the audio follows.</p>
  ) : (
    <div class="ledger">
      <div class="ledger-head">
        <span>ep</span><span>entry</span>
      </div>
      {episodes.map((episode) => (
        <div class="ledger-row">
          <span class="lg-date">#{episode.data.episode}</span>
          <span class="lg-body">
            <span class="lg-meta">
              {episode.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" })} · {episode.data.duration}
            </span>
            <span class="lg-link">{episode.data.title}</span>
            <span class="lg-desc">{episode.data.description}</span>
            <div class="player" data-src={episode.data.enclosureUrl} data-duration={episode.data.duration}>
              <button type="button" class="pl-btn" aria-label={`Play episode ${episode.data.episode}: ${episode.data.title}`}>▶</button>
              <input type="range" class="pl-seek" min="0" max="1000" value="0" step="1" aria-label={`Seek within episode ${episode.data.episode}`} />
              <span class="pl-time">0:00 / {episode.data.duration}</span>
            </div>
          </span>
        </div>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  /* Grid + spacing are podcast-specific; base ledger styles live in global.css */
  .ledger-head, .ledger-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 0 18px;
  }
  .ledger-row {
    padding-block: 0.9rem;
  }
  .lg-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-muted);
    padding-top: 0.25rem;
  }
  .lg-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .lg-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-fg-muted);
    text-transform: lowercase;
  }
  /* Custom episode player — replaces the native <audio controls> widget,
     which renders as an OS-default block that clashes with the ledger. */
  .player {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    max-width: 420px;
    margin-top: 0.5rem;
  }
  .pl-btn {
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-fg-muted);
    border-radius: 4px;
    background: transparent;
    color: var(--color-fg);
    font-size: 0.8rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .pl-btn:hover, .pl-btn.is-playing {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .pl-seek {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    height: 2px;
    background: color-mix(in srgb, var(--color-fg-muted) 35%, transparent);
    border-radius: 1px;
    cursor: pointer;
    outline-offset: 4px;
  }
  .pl-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    border: none;
    margin-top: 0; /* recenters the thumb on the 2px track in Blink */
  }
  .pl-seek::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    border: none;
  }
  .pl-time {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-fg-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* "listen on" strip — platform marks drawn as monoline glyphs in
     currentColor so they inherit the ink/night palette instead of fighting
     it with official brand colors. */
  .listen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .listen-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-fg-muted);
    text-transform: lowercase;
    margin-right: 0.25rem;
  }
  .listen-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--color-fg-muted) 40%, transparent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }
  .listen-pill svg {
    width: 15px;
    height: 15px;
  }
  .listen-pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  @media (max-width: 560px) {
    .ledger-head { display: none; }
    .ledger-row { grid-template-columns: 1fr; }
    .lg-date { margin-bottom: 0.3rem; }
  }
</style>

<script>
  // Episode players: one shared Audio per click, one-at-a-time playback.
  // Seek is a native range input so keyboard scrubbing comes for free.
  const fmt = (s: number) => {
    if (!isFinite(s)) return "0:00";
    const m = Math.floor(s / 60);
    const ss = Math.floor(s % 60).toString().padStart(2, "0");
    return `${m}:${ss}`;
  };

  const parseDur = (d: string) => {
    const [m, s = "0"] = d.split(":");
    return Number(m) * 60 + Number(s);
  };

  let active: { audio: HTMLAudioElement; btn: HTMLButtonElement; seek: HTMLInputElement; time: HTMLElement } | null = null;

  const stop = (p: NonNullable<typeof active>) => {
    p.audio.pause();
    p.btn.textContent = "▸";
    p.btn.classList.remove("is-playing");
    p.btn.setAttribute("aria-label", p.btn.getAttribute("aria-label")!.replace("Pause", "Play"));
  };

  document.querySelectorAll<HTMLElement>(".player").forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>(".pl-btn")!;
    const seek = el.querySelector<HTMLInputElement>(".pl-seek")!;
    const time = el.querySelector<HTMLElement>(".pl-time")!;
    const src = el.dataset.src!;
    const total = parseDur(el.dataset.duration!);
    let audio: HTMLAudioElement | null = null;

    btn.addEventListener("click", () => {
      if (audio && !audio.paused) {
        stop({ audio, btn, seek, time });
        return;
      }
      if (!audio) {
        audio = new Audio(src);
        audio.addEventListener("loadedmetadata", () => {
          if (isFinite(audio!.duration)) time.textContent = `0:00 / ${fmt(audio!.duration)}`;
        });
        audio.addEventListener("timeupdate", () => {
          if (active && active.audio === audio && document.activeElement === seek) return; // don't fight the user's scrub
          if (isFinite(audio!.duration)) seek.value = String((audio!.currentTime / audio!.duration) * 1000);
          time.textContent = `${fmt(audio!.currentTime)} / ${fmt(audio!.duration || total)}`;
        });
        audio.addEventListener("ended", () => {
          seek.value = "0";
          time.textContent = `0:00 / ${fmt(audio!.duration || total)}`;
          stop({ audio: audio!, btn, seek, time });
        });
      }
      if (active && active.audio !== audio) stop(active);
      active = { audio, btn, seek, time };
      audio.play();
      btn.textContent = "❚❚";
      btn.classList.add("is-playing");
      btn.setAttribute("aria-label", btn.getAttribute("aria-label")!.replace("Play", "Pause"));
    });

    seek.addEventListener("input", () => {
      if (!audio || !isFinite(audio.duration)) return;
      audio.currentTime = (Number(seek.value) / 1000) * audio.duration;
    });
  });
</script>
