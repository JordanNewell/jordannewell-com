---
import BaseLayout from "./BaseLayout.astro";
import { softwareApplicationSchema } from "../lib/schema";
import { PRODUCT_STATUS_COLORS } from "../lib/site";
import { getCollection, type CollectionEntry } from "astro:content";

const { product } = Astro.props as { product: CollectionEntry<"products"> };
const {
  title,
  tagline,
  description,
  status,
  repo,
  homepage,
  logo,
  platform,
  shipDate,
  install,
  pricing,
  license,
  stats,
  features,
  comparison,
  faq,
  privacy,
  ogImage,
} = product.data;

const canonicalOg = ogImage ?? `/og-curtis-ai-chat.png`;

const statusColors = PRODUCT_STATUS_COLORS;

const schema = [
  softwareApplicationSchema({
    name: title,
    description,
    slug: product.id,
    repo,
    homepage,
    license,
    shipDate,
    pricing,
    faq,
  }),
];
---

<BaseLayout title={title} description={description} schema={schema} ogImage={canonicalOg}>
  <article class="product">
    <header class="page-head">
      <div class="ph-titlerow">
        <div class="ph-titlegroup">
          {logo && (
            <img src={`${logo}?v=15`} alt="" class="ph-logo" width="40" height="40" loading="eager" />
          )}
          <h1 class="ph-title">{title}</h1>
        </div>
        <p class="ph-stats">
          <span class="stat-n" style={`color: ${statusColors[status] ?? "#7A7683"}`}>{status}</span>
          {platform && <> · <a href={platform.url} target="_blank" rel="noopener" class="ph-stat-link">{platform.name.toLowerCase()} ↗︎</a></>}
          · {license}
          · {status === "released" ? "shipped" : "in development since"} {shipDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}
        </p>
      </div>
      <p class="ph-tag">{tagline}</p>
      <p class="ph-desc">{description}</p>
      <p class="ph-links">
        {install.filter((i) => i.kind === "directory" || i.kind === "brat" || i.kind === "npm" || i.kind === "pip").slice(0, 1).map((i) => (
          <a href={i.href ?? repo} target="_blank" rel="noopener">install {i.label} ↗︎</a>
        ))}
        {repo && <a href={repo} target="_blank" rel="noopener">source ↗︎</a>}
        {homepage && <a href={homepage} target="_blank" rel="noopener">homepage ↗︎</a>}
      </p>
      {stats.length > 0 && (
        <p class="ph-stats-row">
          {stats.map((s) => (
            <span class="ph-stat-pair"><span class="stat-n">{s.v}</span> {s.k}</span>
          ))}
        </p>
      )}
    </header>

    <!-- BODY (custom markdown from content) -->
    <div class="product-body prose">
      <slot />
    </div>

    {install.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Install</h2>
        <div class="ledger">
          {install.map((i) => (
            <div class="ledger-row">
              <span class="lg-name-sm">{i.label}</span>
              {i.href ? (
                <a href={i.href} target="_blank" rel="noopener" class="lg-link-sm">
                  {i.detail ?? i.href.replace(/^https?:\/\//, "").replace(/\/$/, "")} ↗︎
                </a>
              ) : (
                <span class="lg-link-sm lg-muted">{i.detail}</span>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {features.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Features</h2>
        <div class="ledger">
          {features.map((f) => (
            <div class="ledger-row feature-row">
              <span class="lg-name-sm">{f.icon ? `${f.icon} ` : ""}{f.title}</span>
              <span class="lg-desc-sm">
                {f.body}
                {f.docUrl && (<a href={f.docUrl} target="_blank" rel="noopener" class="doc-link">learn more ↗︎</a>)}
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    {comparison && (
      <section class="ledger-section">
        <h2 class="section-h">{comparison.title ?? "How it compares"}</h2>
        <div class="table-wrap">
          <table class="comparison-table">
            <thead>
              <tr>
                <th></th>
                {comparison.columns.map((c) => <th>{c}</th>)}
              </tr>
            </thead>
            <tbody>
              {comparison.rows.map((row) => (
                <tr>
                  <td class="row-label">{row.label}</td>
                  {row.cells.map((cell, i) => <td data-label={comparison.columns[i]}>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {privacy && (
      <section class="ledger-section">
        <h2 class="section-h">Privacy</h2>
        <p class="privacy-body">{privacy}</p>
      </section>
    )}

    {faq.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">FAQ</h2>
        <div class="ledger">
          {faq.map((item) => (
            <div class="ledger-row faq-row">
              <span class="lg-name-sm">{item.q}</span>
              <span class="lg-desc-sm">{item.a}</span>
            </div>
          ))}
        </div>
      </section>
    )}

  </article>
</BaseLayout>

<style>
  /* Shared header/section chrome lives in global.css; layout-specific bits below */
  .product {
    max-width: 60rem;
    margin-inline: auto;
  }

  .page-head { margin-bottom: 2.25rem; }
  .ph-titlerow {
    align-items: center;
  }
  /* Counter the shared .ph-stats margin — product pages never had it */
  .page-head .ph-stats {
    margin: 0;
  }
  .ph-stats {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ph-titlegroup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ph-logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .ph-tag {
    margin-bottom: 0.4rem;
  }
  .ph-desc {
    font-size: 0.92rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
    max-width: 65ch;
    margin-bottom: 1rem;
  }
  .ph-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .ph-links a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ph-links a:hover { color: color-mix(in srgb, var(--color-accent) 82%, #10143A); }
  .ph-stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .product-body { margin-bottom: 3rem; }

  .ledger-section { margin-bottom: 3rem; }
  .ledger-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0 18px;
    padding-block: 0.8rem;
    align-items: baseline;
  }
  .lg-link-sm {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-green);
    text-decoration: none;
    word-break: break-all;
  }
  .lg-link-sm:hover { text-decoration: underline; text-underline-offset: 3px; }
  .doc-link {
    display: inline-block;
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
  }
  .feature-row { grid-template-columns: 220px 1fr; }
  .faq-row { grid-template-columns: 260px 1fr; }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .comparison-table th,
  .comparison-table td {
    padding: 0.625rem 0.875rem;
    text-align: left;
  }
  .comparison-table th {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
  }
  .comparison-table td:not(.row-label) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-fg-secondary);
  }
  .row-label { color: var(--color-fg); font-weight: 500; }

  /* Mobile: stack the comparison table into label/value cards — no sideways scroll */
  @media (max-width: 640px) {
    .comparison-table { display: block; font-size: 0.8rem; }
    .comparison-table thead { display: none; }
    .comparison-table tbody, .comparison-table tr, .comparison-table td { display: block; width: 100%; }
    .comparison-table tr { padding-block: 0.9rem; }
    .comparison-table th,
    .comparison-table td { padding: 0.15rem 0.875rem; }
    .comparison-table td.row-label { padding-bottom: 0.3rem; }
    .comparison-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-fg-muted);
      margin-bottom: 1px;
    }
  }

  .privacy-body {
    color: var(--color-fg-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
    padding-block: 0.9rem;
    border-left: 2px solid var(--color-fg);
    padding-left: 1.25rem;
  }

  @media (max-width: 640px) {
    .ledger-row, .feature-row, .faq-row { grid-template-columns: 1fr; row-gap: 0.25rem; }
  }
</style>
