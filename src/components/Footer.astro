---
import { SITE, FOOTER_PAGE_LINKS } from "../lib/site";

// Tighter footer gap on the home page — READ → should sit symmetric
// between the header and the footer rule.
const { mt = "mt-24" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class={mt}>
  <div class="footer-inner max-w-prose mx-auto px-5 pt-12 pb-18 text-center text-sm text-fg-muted font-mono">
    <p class="mb-4">
      {FOOTER_PAGE_LINKS.map((link, i) => (
        <>
          {i > 0 && <span class="mx-3 text-green" aria-hidden="true">·</span>}
          <a href={link.href} class="hover:text-green">{link.label}</a>
        </>
      ))}
      <span class="mx-3 text-green" aria-hidden="true">·</span>
      <a href="/ventures" class="hover:text-green">ventures</a>
    </p>
    <p class="mb-4">
      <a href="/rss.xml" class="hover:text-green">rss</a>
      <span class="mx-3 text-green" aria-hidden="true">·</span>
      <a href="/feed.json" class="hover:text-green">json</a>
      <span class="mx-3 text-green" aria-hidden="true">·</span>
      <a href="/llms.txt" class="hover:text-green">llms.txt</a>
      <span class="mx-3 text-green" aria-hidden="true">·</span>
      <a href="https://github.com/JordanNewell/jordannewell-com" target="_blank" rel="noopener" class="hover:text-green">source</a>
    </p>
    <p class="mb-6">© {year} {SITE.author.name} <span class="text-green" aria-hidden="true">·</span> <a href="/license" class="hover:text-green">license</a></p>
  </div>
</footer>

<style>
  /* Mobile: raise footer link tap targets to the 40px comfort floor.
     Desktop (>640px) is untouched. Link text is already 14px (text-sm). */
  @media (max-width: 640px) {
    footer p a {
      display: inline-block;
      padding-block: 0.75rem;
    }
  }
</style>
