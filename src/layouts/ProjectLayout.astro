---
import BaseLayout from "./BaseLayout.astro";
import TagPill from "../components/TagPill.astro";
import PostShare from "../components/PostShare.astro";
import { creativeWorkSchema } from "../lib/schema";
import { SITE } from "../lib/site";
import { getCollection, type CollectionEntry } from "astro:content";

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { title, description, status, repo, liveUrl, tags } = project.data;

const shareUrl = `${SITE.url}/projects/${project.id}/`;

const allPosts = await getCollection("posts");
const relatedPosts = allPosts
  .filter((p) => p.data.project === project.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const statusColors: Record<string, string> = {
  active: "#0E8A4A",
  shipped: "#1F4FD8",
  exploratory: "#B45309",
  "venture-track": "#6D28D9",
  deprecated: "#7A7683",
};

const schema = [
  creativeWorkSchema({
    name: title,
    description,
    slug: project.id,
    repo,
    status,
    tags,
  }),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <article class="prose">
    <header class="page-head">
      <div class="ph-titlerow">
        <h1 class="ph-title">{title}</h1>
        <p class="ph-stats">
          <span class="stat-n" style={`color: ${statusColors[status] ?? "#7A7683"}`}>{status}</span>
          {repo && <> · <a href={repo} target="_blank" rel="noopener" class="ph-stat-link">source ↗</a></>}
          {liveUrl && <> · <a href={liveUrl} target="_blank" rel="noopener" class="ph-stat-link">live ↗</a></>}
        </p>
      </div>
      <p class="ph-tag">{description}</p>
      {tags.length > 0 && (
        <p class="ph-tags">
          {tags.map((tag) => <TagPill tag={tag} />)}
        </p>
      )}
    </header>

    {project.data.facts && project.data.facts.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">At a glance</h2>
        <div class="facts-row">
          {project.data.facts.map((fact) => (
            <span class="fact-pair">
              <span class="stat-n">{fact.v}</span> {fact.k}
            </span>
          ))}
        </div>
      </section>
    )}

    {project.data.highlights && project.data.highlights.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Highlights</h2>
        <div>
          {project.data.highlights.map((h) => (
            <div class="ledger-row">
              <span class="lg-name-sm">{h.title}</span>
              <span class="lg-desc-sm">{h.body}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {project.data.stack && project.data.stack.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Stack</h2>
        <p class="stack-line">{project.data.stack.join(" · ")}</p>
      </section>
    )}

    <slot />

    {relatedPosts.length > 0 && (
      <section class="ledger-section">
        <h2 class="section-h">Related</h2>
        <div>
          {relatedPosts.map((p) => (
            <a href={`/posts/${p.id}/`} class="ledger-row rel-row">
              <span class="lg-name-sm">{p.data.title}</span>
              <span class="lg-date-sm">{p.data.pubDate.toISOString().slice(0, 10)}</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <PostShare url={shareUrl} title={title} />
  </article>
</BaseLayout>

<style>
  .page-head { margin-bottom: 2rem; }
  .ph-titlerow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 0.5rem;
    margin-bottom: 0.8rem;
  }
  .ph-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }
  .ph-stats {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .stat-n { color: var(--color-fg); font-weight: 600; }
  .ph-stat-link { color: var(--color-fg-muted); }
  .ph-stat-link:hover { color: var(--color-accent); }
  .ph-tag {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--color-fg-secondary);
    margin-bottom: 0.5rem;
    max-width: 62ch;
  }
  .ph-tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .ledger-section { margin-bottom: 2.25rem; }
  .section-h {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-fg-muted);
    margin-bottom: 0.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-rule-strong);
  }
  .facts-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 0 18px;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }
  .lg-name-sm {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    color: var(--color-fg);
  }
  .lg-desc-sm {
    font-size: 0.9rem;
    color: var(--color-fg-secondary);
    line-height: 1.55;
  }
  .lg-date-sm {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-muted);
    text-align: right;
  }
  .rel-row { text-decoration: none; }
  .rel-row:hover .lg-name-sm {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .stack-line {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-fg-secondary);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .ledger-row { grid-template-columns: 1fr; row-gap: 0.25rem; }
    .lg-date-sm { text-align: left; }
  }
</style>
