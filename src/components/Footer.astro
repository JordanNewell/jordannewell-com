---
import { SITE, FOOTER_PAGE_LINKS } from "../lib/site";

const { mt = "mt-12" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class={mt}>
  <div class="footer-inner max-w-prose mx-auto px-5 pt-6 text-center text-sm text-fg-muted font-mono">
    <p class="mb-4">
      {FOOTER_PAGE_LINKS.map((link, i) => (
        <>
          {i > 0 && <span class="mx-3 text-green" aria-hidden="true">·</span>}
          <a href={link.href} class="hover:text-green">{link.label}</a>
        </>
      ))}
      <span class="mx-3 text-green" aria-hidden="true">·</span>
      <a href="/ventures" class="hover:text-green">ventures</a>
    </p>
    <p class="mb-4">
      <a href="/rss.xml" class="hover:text-green">rss</a>
      <span class="mx-3 text-green" aria-hidden="true">·</span>
      <a href="/feed.json" class="hover:text-green">json</a>
      <span class="mx-3 text-green" aria-hidden="true">·</span>
      <a href="/llms.txt" class="hover:text-green">llms.txt</a>
      <span class="mx-3 text-green" aria-hidden="true">·</span>
      <a href="https://github.com/JordanNewell/jordannewell-com" target="_blank" rel="noopener" class="hover:text-green">source</a>
    </p>
    <p>© {year} {SITE.author.name} <span class="text-green" aria-hidden="true">·</span> <a href="/license" class="hover:text-green">license</a></p>
  </div>
  <!-- N mark at true page bottom, centered — interleaf canonical footer pattern -->
  <div class="balloon-n" aria-hidden="true">
    <img src="/n-balloon-light.png" alt="" class="character-light" width="200" height="200" />
    <img src="/n-balloon-dark.png" alt="" class="character-dark" width="200" height="200" />
  </div>
</footer>

<style>
  /* N mark at true page bottom — centered, below the last footer row.
     Interleaf canonical footer pattern (never left-align, never mid-page). */
  .balloon-n {
    display: flex;
    justify-content: center;
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
    line-height: 0;
  }
  .balloon-n img {
    height: 1.75rem; /* 28px */
    width: auto;
    opacity: 0.9;
  }
  @media (max-width: 640px) {
    .balloon-n img {
      height: 1.5rem; /* 24px */
    }
  }
  .balloon-n .character-dark {
    display: none;
  }
  :global([data-theme="dark"]) .balloon-n .character-dark {
    display: block;
  }
  :global([data-theme="dark"]) .balloon-n .character-light {
    display: none;
  }
  /* Footer link tap targets — applies at ALL widths so the footer rhythm
     matches mobile (Jordan 2026-10-17: mobile spacing looks better). */
  footer p a {
    display: inline-block;
    padding-block: 0.75rem;
  }
  .footer-inner {
    padding-top: 48px;
  }
  @media (min-width: 561px) {
    .footer-inner {
      padding-top: 41px;
    }
    .footer-inner p.mb-4 {
      margin-bottom: 10px; /* was mb-4 (16px) */
    }
  }
</style>
