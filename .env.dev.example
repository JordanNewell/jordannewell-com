# Dev-site deploy environment — copy to .env.dev and fill in real values
# .env.dev is gitignored (same rules as .env). Never commit real values.
#
# Usage:
#   cp .env.dev.example .env.dev
#   # edit .env.dev, then:
#   ENV_FILE=.env.dev bash scripts/deploy.sh
#
# Same host as production, different web root. The dev vhost
# (dev.jordannewell.com) serves REMOTE_PATH below.

# Same SSH target as .env (or an alias for the same box)
REMOTE_HOST=user@host

# Web root for the dev site on the remote host.
# This directory will be CLEARED AND REPLACED on every deploy.
REMOTE_PATH=/path/to/dev-webroot

# Backups for dev deploys (can share the prod backup dir)
BACKUP_DIR=/path/to/backups
