---
import { NAV_LINKS } from "../lib/site";
const { path } = Astro.props;
---

<header class="border-b border-border">
  <div class="header-inner max-w-prose mx-auto px-5 py-3.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <nav class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-[0.72rem]">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class={`font-mono transition-colors whitespace-nowrap ${
            path === link.href ? "text-accent" : "text-fg-muted hover:text-fg"
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a href="/" class="hdr-n" aria-label="Jordan Newell — home">
      <img src="/images/newell-icon.png" alt="" width="1024" height="1024" loading="eager" />
    </a>
  </div>
</header>

<style>
  .hdr-n {
    display: flex;
    align-items: center;
    /* sized to the menu, not the other way around */
    line-height: 0;
    opacity: 0.95;
    transition: opacity 0.15s;
  }
  .hdr-n img { width: 28px; height: auto; }
  .hdr-n:hover { opacity: 1; }

  /* Mobile: raise tap targets to the 40px comfort floor and legible font size.
     Desktop (>640px) is untouched. */
  @media (max-width: 640px) {
    .header-inner {
      padding-block: 0.125rem;
    }
    nav {
      font-size: 0.8125rem;
      gap: 0.25rem 0.5rem;
    }
    nav a {
      display: inline-block;
      padding-block: 0.75rem;
    }
  }
</style>
