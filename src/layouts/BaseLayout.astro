---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import { SITE } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  schema?: object[];
  path?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  schema = [],
  path = Astro.url.pathname,
  ogImage,
  noindex = false,
} = Astro.props;

const canonical = Astro.url.href;
// Brand the title only while the whole thing fits a SERP line (~60 chars);
// long post titles stand alone rather than truncating mid-sentence.
const brandSuffix = ` — ${SITE.title}`;
const ogTitle =
  title === SITE.title || title.length + brandSuffix.length > 60
    ? title
    : `${title}${brandSuffix}`;
// Meta descriptions clip past ~160 chars in search results anyway; the full
// text still ships in the page body and JSON-LD.
const metaDescription =
  description.length > 160 ? `${description.slice(0, 157).trimEnd()}…` : description;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith("http") ? ogImage : `${SITE.url}${ogImage}`)
  : `${SITE.url}/og-card.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ogTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="license" href="https://creativecommons.org/licenses/by-nc/4.0/" />
    <meta name="copyright" content="© 2026 Jordan Newell. CC BY-NC 4.0." />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" type="application/json" title={SITE.title} href="/feed.json" />
    <SchemaOrg schema={schema} />
    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "012b8a7bc7594c91aff6f05cab5951fd"}'></script>
  </head>
  <body>
    <div class="relative z-1">
      <Header path={path} />
      <a href="/" class="under-header-character max-w-prose mx-auto px-5" aria-label="Jordan Newell — home">
        <img src="/images/newell-character.png" alt="" width="320" height="320" />
      </a>
      <main class="max-w-prose mx-auto px-5 py-12">
        <slot />
      </main>
      <Footer />
    </div>
    <div class="status-bar">
      <a href="https://status.jordannewell.com" data-status-badge class="status-badge is-down" target="_blank" rel="noopener" aria-label="System status (status.jordannewell.com)">
        <svg class="ekg" viewBox="0 0 144 20" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
          <path class="ekg-trace" vector-effect="non-scaling-stroke" stroke-linejoin="round" d="M-72 13 L-56 13 L-52 10 L-48 13 L-42 13 L-39 15 L-36 2 L-33 18 L-30 13 L-20 13 L-16 8 L-12 13 L0 13 L16 13 L20 10 L24 13 L30 13 L33 15 L36 2 L39 18 L42 13 L52 13 L56 8 L60 13 L72 13 L88 13 L92 10 L96 13 L102 13 L105 15 L108 2 L111 18 L114 13 L124 13 L128 8 L132 13 L144 13 L160 13 L164 10 L168 13 L174 13 L177 15 L180 2 L183 18 L186 13 L196 13 L200 8 L204 13 L216 13" />
          <path class="ekg-flat" vector-effect="non-scaling-stroke" d="M0 13 L144 13" />
        </svg>
        <span data-status-dot class="status-dot"></span>
        <span data-status-text class="status-text">All systems operational</span>
      </a>
    </div>
    <style>
      body { padding-bottom: 3rem; }
      .status-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 50;
        border-top: 1px solid var(--color-border);
        background-color: var(--color-bg);
      }
      .status-bar .status-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 6px 1.25rem;
        text-decoration: none;
      }
      .ekg { flex: 0 1 340px; min-width: 64px; max-width: 340px; height: 16px; }
      .ekg-trace, .ekg-flat { fill: none; stroke-width: 1.5; }
      .ekg-trace { display: none; stroke: var(--color-green); }
      .ekg-flat { stroke: var(--color-amber); }
      .status-badge.is-up .ekg-trace {
        display: block;
        animation: ekg-scroll 2s linear infinite;
      }
      .status-badge.is-up .ekg-flat { display: none; }
      @keyframes ekg-scroll {
        from { transform: translateX(0); }
        to   { transform: translateX(-72px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .status-badge.is-up .ekg-trace { animation: none; }
      }
      .under-header-character {
        display: flex;
        justify-content: flex-end;
        padding-top: 14px;
        line-height: 0;
        opacity: 0.9;
        transition: opacity 0.15s, transform 0.15s;
      }
      .under-header-character img { width: 88px; height: 88px; }
      .under-header-character:hover { opacity: 1; transform: translateY(-2px); }
      @media (max-width: 560px) {
        .under-header-character img { width: 64px; height: 64px; }
      }
    </style>
    <script src="/js/main.js" defer></script>
  </body>
</html>
