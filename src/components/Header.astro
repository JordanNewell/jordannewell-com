---
import { NAV_LINKS } from "../lib/site";
const { path } = Astro.props;
---

<header>
  <div class="header-inner max-w-prose mx-auto px-5 py-3.5 flex flex-wrap items-center gap-x-4 gap-y-2">
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle day/night">
      <span class="switch3d" aria-hidden="true"><span class="rocker"></span></span>
    </button>
    <nav class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-[0.72rem]">
      {NAV_LINKS.map((link, i) => (
        <>
          {i > 0 && <span class="text-accent" aria-hidden="true">|</span>}
          <a
            href={link.href}
            class={`font-mono transition-colors whitespace-nowrap ${
              path === link.href ? "text-accent" : "text-fg-muted hover:text-fg"
            }`}
          >
            {link.label}
          </a>
        </>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Mobile: raise tap targets to the 40px comfort floor and legible font size.
     Desktop (>640px) is untouched. */
  @media (max-width: 640px) {
    .header-inner {
      padding-block: 0.125rem;
    }
    nav {
      font-size: 0.8125rem;
      gap: 0.25rem 0.5rem;
    }
    nav a {
      display: inline-block;
      padding-block: 0.75rem;
    }
  }
  .theme-toggle {
    margin-right: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1;
    color: var(--color-fg-muted);
    background: none;
    border: none;
    padding: 0.375rem 0.25rem;
    cursor: pointer;
    transition: color 0.15s;
  }
  .theme-toggle:hover { color: var(--color-fg); }
  /* B/W light switch — rocker physically flips on its X axis.
     Day: bottom pressed in (lights on). Night: top pressed in (off). */
  .switch3d {
    display: inline-block;
    width: 16px;
    height: 25px;
    padding: 2.5px;
    background: #111114;
    border-radius: 3.5px;
    border: 1px solid #2a2a2e;
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.7),
      0 1px 0 rgba(255, 255, 255, 0.12);
    perspective: 80px;
  }
  .rocker {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(#ffffff, #d9d9d9);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.55),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12);
    transform: rotateX(24deg);
    transform-style: preserve-3d;
    transition: transform 0.18s ease;
  }
  .theme-toggle:hover .rocker { background: linear-gradient(#ffffff, #e6e6e6); }
  :global([data-theme="dark"]) .rocker {
    transform: rotateX(-24deg);
    background: linear-gradient(#e9e9e9, #bdbdbd);
    box-shadow:
      0 -1px 1px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle")!;
  btn.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>
