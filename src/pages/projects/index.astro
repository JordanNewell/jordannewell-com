---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projects = [...allProjects].sort((a, b) => a.data.order - b.data.order);

const countBy = (status: string) => allProjects.filter((p) => p.data.status === status).length;
const counts = {
  total: allProjects.length,
  shipped: countBy("shipped"),
  active: countBy("active"),
  exploratory: countBy("exploratory"),
  deprecated: countBy("deprecated"),
};

const statusColors: Record<string, string> = {
  active: "#0E8A4A",
  shipped: "#1F4FD8",
  exploratory: "#7A7683",
  "venture-track": "#A16207",
  deprecated: "#A8A3AD",
};

const pkgLabel = (url: string): string => {
  try {
    const host = new URL(url).hostname;
    if (host.includes("npmjs")) return "npm";
    if (host.includes("pypi.org")) return "pypi";
    if (host.includes("obsidian.md")) return "obsidian";
    if (host.includes("crates.io")) return "crates";
    return "pkg";
  } catch {
    return "pkg";
  }
};
---

<BaseLayout title="Projects" description="What I've built, in public." ogImage="/og-projects.png">
  <h1 class="sr-only">Projects</h1>
  <p class="ph-stats">
    <span class="stat-n">{counts.total}</span> total · <span class="stat-n">{counts.shipped}</span> shipped · <span class="stat-n">{counts.active}</span> active · <span class="stat-n">{counts.exploratory}</span> exploratory{counts.deprecated > 0 && (<> · <span class="stat-n">{counts.deprecated}</span> deprecated</>)}
  </p>

  <div class="ledger">
    <div class="ledger-head">
      <span>project</span><span>status</span><span>links</span><span>what it is</span>
    </div>
    {projects.map((p) => (
      <div class="ledger-row">
        <span class="lg-name">
          <a href={`/projects/${p.id}/`} class="lg-link">{p.data.title}</a>
        </span>
        <span
          class="lg-st"
          style={`color: ${statusColors[p.data.status] ?? "#7A7683"}`}
        >
          {p.data.status}
        </span>
        <span class="lg-links">
          {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener" class="lk lk-green">src ↗</a>}
          {p.data.pkg && <a href={p.data.pkg} target="_blank" rel="noopener" class="lk lk-cyan">{pkgLabel(p.data.pkg)} ↗</a>}
          {p.data.liveUrl && <a href={p.data.liveUrl} target="_blank" rel="noopener" class="lk lk-green">live ↗</a>}
          {!p.data.repo && !p.data.pkg && !p.data.liveUrl && <span class="lg-muted">—</span>}
        </span>
        <span class="lg-desc">{p.data.description}</span>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .ph-stats {
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
  }
  .stat-n { color: var(--color-fg); font-weight: 600; }

  .ledger-head, .ledger-row {
    display: grid;
    grid-template-columns: 1.1fr 0.65fr 0.75fr 1.7fr;
    gap: 14px;
    align-items: baseline;
  }
  .ledger-head {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--color-rule-strong);
  }
  .ledger-row {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }
  .lg-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .lg-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lg-st {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .lg-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }
  .lk { text-decoration: none; }
  .lk-green { color: var(--color-green); }
  .lk-cyan { color: var(--color-cyan); }
  .lk:hover { text-decoration: underline; text-underline-offset: 3px; }
  .lg-muted { color: var(--color-fg-muted); }
  .lg-desc {
    font-size: 0.92rem;
    color: var(--color-fg-secondary);
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .ledger-head { display: none; }
    .ledger-row {
      grid-template-columns: 1fr auto;
      row-gap: 0.35rem;
    }
    .lg-links { grid-column: 1 / -1; order: 3; }
    .lg-desc { grid-column: 1 / -1; }
  }
</style>
