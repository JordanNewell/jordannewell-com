---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projects = [...allProjects].sort((a, b) => a.data.order - b.data.order);
const graduated = projects.filter((p) => p.data.promotedTo);
const ledgerProjects = projects.filter((p) => !p.data.promotedTo);

const fmtSince = (d?: Date) =>
  d ? `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, "0")}` : "—";

const countBy = (status: string) => allProjects.filter((p) => p.data.status === status).length;
const counts = {
  total: allProjects.length,
  shipped: countBy("shipped"),
  active: countBy("active"),
  exploratory: countBy("exploratory"),
  deprecated: countBy("deprecated"),
};

// NOTE: intentionally different from ProjectLayout's statusColors — this index
// uses quieter inks for exploratory/venture-track/deprecated. Do not merge.
const statusColors: Record<string, string> = {
  active: "#0E8A4A",
  shipped: "#1F4FD8",
  exploratory: "#7A7683",
  "venture-track": "#A16207",
  deprecated: "#A8A3AD",
};

const pkgLabel = (url: string): string => {
  try {
    const host = new URL(url).hostname;
    if (host.includes("npmjs")) return "npm";
    if (host.includes("pypi.org")) return "pypi";
    if (host.includes("obsidian.md")) return "obsidian";
    if (host.includes("crates.io")) return "crates";
    return "pkg";
  } catch {
    return "pkg";
  }
};
---

<BaseLayout title="Projects" description="What I've built, in public." ogImage="/og-projects.png">
  <h1 class="sr-only">Projects</h1>
  <p class="ph-stats">
    <span class="stat-n">{counts.total}</span> total · <span class="stat-n">{counts.shipped}</span> shipped · <span class="stat-n">{counts.active}</span> active · <span class="stat-n">{counts.exploratory}</span> exploratory{counts.deprecated > 0 && (<> · <span class="stat-n">{counts.deprecated}</span> deprecated</>)}
  </p>

  {graduated.length > 0 && (
    <div class="graduated">
      <p class="grad-head">graduated — projects that became products</p>
      {graduated.map((p) => (
        <div class="grad-row">
          <a href={`/projects/${p.id}/`} class="grad-name">{p.data.title}</a>
          <span class="grad-arrow">→</span>
          <a href={p.data.promotedTo} class="grad-link">{p.data.promotedTo.split("/")[2]}</a>
        </div>
      ))}
    </div>
  )}

  <div class="ledger">
    <div class="ledger-head">
      <span>project</span><span>status</span><span>since</span><span>links</span><span>what it is</span>
    </div>
    {ledgerProjects.map((p) => (
      <div class="ledger-row">
        <span class="lg-name">
          <a href={`/projects/${p.id}/`} class="lg-link">{p.data.title}</a>
          {p.data.successor && <span class="lg-succ">→ <a href={`/projects/${p.data.successor}/`}>{p.data.successor}</a></span>}
        </span>
        <span
          class="lg-st"
          style={`color: ${statusColors[p.data.status] ?? "#7A7683"}`}
        >
          {p.data.status}
        </span>
        <span class="lg-since">{fmtSince(p.data.startDate)}</span>
        <span class="lg-links">
          {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener" class="lk lk-green">src ↗︎</a>}
          {p.data.pkg && <a href={p.data.pkg} target="_blank" rel="noopener" class="lk lk-cyan">{pkgLabel(p.data.pkg)} ↗︎</a>}
          {p.data.liveUrl && <a href={p.data.liveUrl} target="_blank" rel="noopener" class="lk lk-green">live ↗︎</a>}
          {!p.data.repo && !p.data.pkg && !p.data.liveUrl && <span class="lg-muted">—</span>}
        </span>
        <span class="lg-desc">{p.data.description}</span>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  /* Grid + spacing are projects-specific; base ledger styles live in global.css */
  .ledger-head, .ledger-row {
    display: grid;
    grid-template-columns: 1.1fr 0.65fr 0.45fr 0.75fr 1.7fr;
    gap: 14px;
    align-items: baseline;
  }
  .lg-since {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-fg-muted, #7A7683);
    white-space: nowrap;
  }
  .lg-succ {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-fg-muted, #7A7683);
    margin-left: 8px;
    white-space: nowrap;
  }
  .lg-succ a { color: inherit; }
  .graduated {
    margin-bottom: 2.5rem;
  }
  .grad-head {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg-muted, #7A7683);
    margin-bottom: 0.6rem;
  }
  .grad-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-block: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .grad-name { color: var(--color-fg); text-decoration: none; }
  .grad-name:hover { text-decoration: underline; text-underline-offset: 3px; }
  .grad-arrow { color: var(--color-green); }
  .grad-link { color: var(--color-green); text-decoration: none; }
  .grad-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ledger-row {
    padding-block: 0.85rem;
  }
  .lg-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }
  .lk { text-decoration: none; }
  .lk-green { color: var(--color-green); }
  .lk-cyan { color: var(--color-cyan); }
  .lk:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) {
    .ledger-head { display: none; }
    .ledger-row {
      grid-template-columns: 1fr auto;
      row-gap: 0.35rem;
    }
    .lg-links { grid-column: 1 / -1; order: 3; }
    .lg-desc { grid-column: 1 / -1; }
  }
</style>
