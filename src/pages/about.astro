---
import BaseLayout from "../layouts/BaseLayout.astro";
import { personSchema } from "../lib/schema";
import { SITE } from "../lib/site";

const schema = [personSchema()];
---

<BaseLayout title="About" description="Operator shipping in public across sectors." schema={schema} ogImage="/og-about.png">
  <article class="prose">
    <h1 class="sr-only">About Jordan Newell</h1>
    <p>
      Jordan Newell. Building and operating the systems behind ambitious ventures —
      a self-hosted fleet of AI agents running around the clock, infrastructure that
      carries mail, status pages, and sites for real businesses, and a growing
      collection of software projects shipping into the world. By day: compliance and
      modernization work at <a href="https://richmondpark.co">Richmond Park Group</a>
      and the backend of DW Trim as Managing Partner. On my own time: <a href="https://curtisai.tech">Curtis AI ↗</a>,
      agent fleets, and this blog.
    </p>
    <p>
      <strong>The operator's desk.</strong> Field notes, post-mortems,
      manifestos when warranted.
    </p>

    <h2>Let's build together</h2>
  </article>
</BaseLayout>
