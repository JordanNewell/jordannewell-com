---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);

const shippedCount = products.filter(
  (p) => p.data.status === "released",
).length;

const statusColors: Record<string, string> = {
  released: "#0E8A4A",
  beta: "#B45309",
  preview: "#7A7683",
};

const platformLabel = (url: string): string => {
  try {
    const host = new URL(url).hostname;
    if (host.includes("obsidian.md")) return "obsidian";
    if (host.includes("npmjs")) return "npm";
    if (host.includes("pypi.org")) return "pypi";
    if (host.includes("crates.io")) return "crates";
    return "pkg";
  } catch {
    return "pkg";
  }
};
---

<BaseLayout title="Products" description="Polished software Jordan Newell ships and stands behind.">
  <h1 class="sr-only">Products</h1>
  <p class="ph-stats">
    <span class="stat-n">{shippedCount}</span> shipped · MIT licensed · <span class="stat-n">0</span> telemetry
  </p>

  <div class="ledger">
    <div class="ledger-head">
      <span>product</span><span>status</span><span>pkg</span><span>what it is</span>
    </div>
    {products.map((p) => (
      <a href={`/products/${p.id}/`} class="ledger-row">
        <span class="lg-logo-cell">{p.data.logo && <img src={`${p.data.logo}?v=11`} alt="" width="18" height="18" class="lg-logo" loading="lazy" />}</span>
        <span class="lg-name">{p.data.title}</span>
        <span
          class="lg-st"
          style={`color: ${statusColors[p.data.status] ?? "#7A7683"}`}
        >
          {p.data.status}
        </span>
        <span class="lg-pkg">
          {p.data.platform ? `${platformLabel(p.data.platform.url)} ↗` : "—"}
        </span>
        <span class="lg-desc">{p.data.description}</span>
      </a>
    ))}
    {products.length === 0 && (
      <p class="text-[0.92rem] text-fg-muted italic">No products listed yet — check back soon.</p>
    )}
  </div>
</BaseLayout>

<style>
  .ph-stats {
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
  }
  .stat-n { color: var(--color-fg); font-weight: 600; }

  .ledger-head, .ledger-row {
    display: grid;
    grid-template-columns: 26px minmax(0, 1.1fr) auto minmax(0, 0.45fr) minmax(0, 1.7fr);
    gap: 14px;
    align-items: baseline;
  }
  .ledger-head {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--color-rule-strong);
  }
  .ledger-row {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
  }
  .lg-logo-cell {
    display: flex;
    align-items: center;
  }
  .lg-logo {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    display: block;
  }
  .lg-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    transition: color 0.15s ease;
  }
  .ledger-row:hover .lg-name {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lg-st {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .lg-pkg {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-fg-muted);
    white-space: nowrap;
  }
  .lg-desc {
    font-size: 0.92rem;
    color: var(--color-fg-secondary);
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .ledger-head span:nth-child(3) { display: none; }
    .lg-pkg { display: none; }
    .ledger-head, .ledger-row {
      grid-template-columns: 26px minmax(0, 1.1fr) auto minmax(0, 1.7fr);
    }
  }
  @media (max-width: 640px) {
    .ledger-head { display: none; }
    .ledger-row {
      grid-template-columns: 26px 1fr auto;
      row-gap: 0.3rem;
    }
    .lg-pkg { display: none; }
    .lg-desc { grid-column: 1 / -1; }
  }
</style>
