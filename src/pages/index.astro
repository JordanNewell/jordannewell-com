---
import { execSync } from "child_process";
import { existsSync } from "node:fs";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 1);

const heroFor = (id: string): string | null => {
  for (const ext of ["png", "jpg", "jpeg", "webp"]) {
    if (existsSync(`public/posts/${id}/hero.${ext}`)) return `/posts/${id}/hero.${ext}`;
  }
  return null;
};

let lastCommitSha: string | null = null;
let lastCommitDate: Date | null = null;
try {
  lastCommitSha = execSync("git rev-parse --short HEAD").toString().trim();
  const ts = execSync("git log -1 --format=%cI").toString().trim();
  lastCommitDate = new Date(ts);
} catch {
  lastCommitSha = null;
  lastCommitDate = null;
}

const buildTime = new Date();
---

<BaseLayout title="Jordan Newell" description="I build and operate the systems behind ambitious ventures." path="/">
  <h1 class="sr-only">I build and operate the systems behind ambitious ventures.</h1>

  <section class="section">
    <div class="live-rows">
      {lastCommitSha && lastCommitDate && (
        <div class="live-row">
          <div class="live-label">Last commit</div>
          <div class="live-value">
            <span class="mono-sha">{lastCommitSha}</span>
            <span class="live-relative" data-timestamp={lastCommitDate.toISOString()}>…</span>
          </div>
        </div>
      )}
      <div class="live-row">
        <div class="live-label">Built</div>
        <div class="live-value">
          <span class="live-relative" data-timestamp={buildTime.toISOString()}>…</span>
        </div>
      </div>
      <div class="live-row">
        <div class="live-label">Status</div>
        <a href="https://status.jordannewell.com" data-status-badge class="status-badge status-link is-down" target="_blank" rel="noopener" aria-label="System status (status.jordannewell.com)">
          <svg class="ekg" viewBox="0 0 144 20" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
            <path class="ekg-trace" vector-effect="non-scaling-stroke" stroke-linejoin="round" d="M-72 13 L-56 13 L-52 10 L-48 13 L-42 13 L-39 15 L-36 2 L-33 18 L-30 13 L-20 13 L-16 8 L-12 13 L0 13 L16 13 L20 10 L24 13 L30 13 L33 15 L36 2 L39 18 L42 13 L52 13 L56 8 L60 13 L72 13 L88 13 L92 10 L96 13 L102 13 L105 15 L108 2 L111 18 L114 13 L124 13 L128 8 L132 13 L144 13 L160 13 L164 10 L168 13 L174 13 L177 15 L180 2 L183 18 L186 13 L196 13 L200 8 L204 13 L216 13" />
            <path class="ekg-flat" vector-effect="non-scaling-stroke" d="M0 13 L144 13" />
          </svg>
          <span data-status-dot class="status-dot"></span>
          <span data-status-text class="status-text">All systems operational</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div>
      {posts.map((post, i) => {
        const hero = i === 0 ? heroFor(post.id) : null;
        return (
          <a href={`/posts/${post.id}/`} class={`post-item${hero ? " post-featured" : ""}`}>
            {hero ? (
              <>
                <div class="featured-head">
                  <div class="post-date">
                    {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}
                  </div>
                  <div class="featured-title">{post.data.title}</div>
                </div>
                <span class="featured-cover">
                  <img src={hero} alt="" width="1168" height="784" loading="eager" />
                </span>
              </>
            ) : (
              <div class="post-grid">
                <div class="post-date">
                  {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}
                </div>
                <div>
                  <div class="post-title">{post.data.title}</div>
                  <div class="post-desc">{post.data.description}</div>
                </div>
              </div>
            )}
            <div class="read-this">read this post →</div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .section { margin-bottom: 64px; }
  .section:last-of-type { margin-bottom: 0; }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.65rem; color: var(--color-fg-muted);
    letter-spacing: 0.18em; text-transform: uppercase;
    margin-bottom: 8px; display: flex; align-items: center; gap: 8px;
    padding-bottom: 6px;
  }

  .live-rows { display: flex; flex-direction: column; }
  .live-row {
    display: grid; grid-template-columns: 110px 1fr; gap: 0 18px;
    padding-block: 12px;
    border-bottom: 1px solid var(--color-border);
  }
  .live-row:last-child { border-bottom: none; }
  .live-label {
    font-family: var(--font-mono);
    font-size: 0.65rem; color: var(--color-fg-muted);
    letter-spacing: 0.08em; text-transform: uppercase; padding-top: 3px;
  }
  .live-value {
    font-family: var(--font-mono);
    font-size: 0.82rem; color: var(--color-fg);
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  .mono-sha { color: var(--color-green); }
  .live-relative {
    font-size: 0.7rem; color: var(--color-fg-muted);
  }

  /* Status heartbeat monitor — state classes driven by public/js/main.js
     via data-status-badge (same machinery as the footer badge). Trace repeats
     every 72 viewBox units; the scroll animation advances exactly one period
     so the strip loops with no visible seam at any rendered width. */
  .status-link {
    display: flex; align-items: center; gap: 10px;
    width: 100%; min-width: 0; text-decoration: none;
  }
  .live-head .status-link {
    width: auto; margin-left: auto; flex: 0 1 auto;
    font-family: var(--font-mono);
    font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase;
  }
  .ekg { flex: 1 1 auto; min-width: 96px; max-width: 340px; height: 20px; }
  .ekg-trace, .ekg-flat { fill: none; stroke-width: 1.5; }
  /* Pre-JS / degraded / down: flatline in the badge's default amber */
  .ekg-trace { display: none; }
  .ekg-flat { stroke: var(--color-amber); }
  /* Operational: green trace scrolling continuously */
  .status-badge.is-up .ekg-trace {
    display: block; stroke: var(--color-green);
    animation: ekg-scroll 2s linear infinite;
  }
  .status-badge.is-up .ekg-flat { display: none; }
  .status-link .status-dot {
    width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
  }
  .status-link .status-text {
    font-family: var(--font-mono);
    font-size: 0.78rem; letter-spacing: 0.02em; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }

  @keyframes ekg-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-72px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-badge.is-up .ekg-trace { animation: none; }
  }

  .post-item {
    display: block; text-decoration: none;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--color-border);
  }
  .featured-head {
    text-align: center;
    margin-bottom: 0.9rem;
  }
  .featured-head .post-date { padding-top: 0; }
  .featured-title {
    font-family: var(--font-sans);
    font-weight: 600; font-size: 1.45rem; letter-spacing: -0.005em;
    color: var(--color-fg);
    margin-top: 5px;
    transition: color 0.15s;
  }
  .post-item:hover .featured-title { color: var(--color-accent); }
  .featured-cover {
    display: block;
  }
  .featured-cover img {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--color-border);
  }
  .post-grid {
    display: grid; grid-template-columns: 110px 1fr; gap: 0 18px;
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.7rem; color: var(--color-fg-muted);
    letter-spacing: 0.03em; padding-top: 0.3rem;
  }
  .post-title {
    font-family: var(--font-display);
    font-weight: 600; font-size: 0.95rem; letter-spacing: -0.01em;
    color: var(--color-fg); margin-bottom: 4px;
    transition: color 0.15s;
  }
  .post-item:hover .post-title {
    color: var(--color-accent);
    text-decoration: underline; text-underline-offset: 4px;
  }
  .post-desc {
    font-size: 0.92rem; color: var(--color-fg-secondary);
    line-height: 1.5;
  }
  .read-this {
    margin-top: 0.9rem; text-align: center;
    font-family: var(--font-mono);
    font-size: 0.7rem; color: var(--color-fg-muted); 
    letter-spacing: 0.08em; text-transform: uppercase;
    transition: color 0.15s;
  }
  .post-item:hover .read-this { color: var(--color-accent); }

  @media (max-width: 560px) {
    .live-row, .post-grid { grid-template-columns: 1fr; }
    .live-label, .post-date { margin-bottom: 0.3rem; }
  }
</style>
