---
import { SITE, FOOTER_PAGE_LINKS } from "../lib/site";

// Tighter footer gap on the home page — READ → should sit symmetric
// between the header and the footer rule.
const { mt = "mt-24" } = Astro.props;
const year = new Date().getFullYear();
---

<footer class={mt}>
  <div class="footer-inner max-w-prose mx-auto px-5 py-12 text-center text-sm text-fg-muted font-mono">
    <!-- N mark caps the footer like a pyramidion -->
    <div class="balloon-n" aria-hidden="true">
      <img src="/n-balloon.png" alt="" class="character-light" width="200" height="200" loading="lazy" />
      <img src="/n-balloon-dark.png" alt="" class="character-dark" width="200" height="200" loading="lazy" />
    </div>
    <p class="mb-4">
      {FOOTER_PAGE_LINKS.map((link, i) => (
        <>
          {i > 0 && <span class="mx-3 text-accent" aria-hidden="true">·</span>}
          <a href={link.href} class="hover:text-accent">{link.label}</a>
        </>
      ))}
      <span class="mx-3 text-accent" aria-hidden="true">·</span>
      <a href="/ventures" class="hover:text-accent">ventures</a>
    </p>
    <p class="mb-4">
      <a href="/rss.xml" class="hover:text-accent">rss</a>
      <span class="mx-3 text-accent" aria-hidden="true">·</span>
      <a href="/feed.json" class="hover:text-accent">json</a>
      <span class="mx-3 text-accent" aria-hidden="true">·</span>
      <a href="/llms.txt" class="hover:text-accent">llms.txt</a>
      <span class="mx-3 text-accent" aria-hidden="true">·</span>
      <a href="https://github.com/JordanNewell/jordannewell-com" target="_blank" rel="noopener" class="hover:text-accent">source</a>
    </p>
    <p class="mb-6">© {year} {SITE.author.name} <span class="text-accent" aria-hidden="true">·</span> <a href="/license" class="hover:text-accent">license</a></p>
  </div>
</footer>

<style>
  .balloon-n {
    display: flex;
    justify-content: center;
    padding-bottom: 1.5rem;
  }
  .balloon-n img {
    height: 1.6rem;
    width: auto;
  }
  .balloon-n .character-dark {
    display: none;
  }
  :global([data-theme="dark"]) .balloon-n .character-dark {
    display: block;
  }
  :global([data-theme="dark"]) .balloon-n .character-light {
    display: none;
  }
  /* Mobile: raise footer link tap targets to the 40px comfort floor.
     Desktop (>640px) is untouched. Link text is already 14px (text-sm). */
  @media (max-width: 640px) {
    footer p a {
      display: inline-block;
      padding-block: 0.75rem;
    }
  }
</style>
