---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const allContributions = await getCollection("contributions");
const contributions = [...allContributions].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const statusColor: Record<string, string> = {
  shipped: "var(--color-green)",
  open: "var(--color-cyan)",
  investigating: "var(--color-amber)",
  "closed-wontfix": "var(--color-fg-muted)",
};
const statusLabel: Record<string, string> = {
  shipped: "shipped",
  open: "open",
  investigating: "investigating",
  "closed-wontfix": "closed",
};

const projectLogos: Record<string, string> = {
  "charmbracelet/crush": "/images/logos/charmbracelet.png",
  OpenClaw: "/images/logos/openclaw.png",
};

const countBy = (status: string) => allContributions.filter((c) => c.data.status === status).length;
const projects = [...new Set(allContributions.map((c) => c.data.project))];
---

<BaseLayout title="Contributions" description="Verifiable OSS contributions — bugs filed, PRs merged, community engagement." ogImage="/og-contributions.png">
  <h1 class="sr-only">Contributions</h1>
  <p class="ph-stats">
    <span class="stat-n">{allContributions.length}</span> total · <span class="stat-n">{countBy("shipped")}</span> shipped · <span class="stat-n">{countBy("open") + countBy("investigating")}</span> open · <span class="stat-n">{projects.length}</span> projects
  </p>

  <div class="ledger">
    <div class="ledger-head">
      <span>date</span><span>entry</span>
    </div>
    {contributions.map((c) => (
      <div class="ledger-row">
        <span class="lg-date">
          {c.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", timeZone: "UTC" })}
        </span>
        <span class="lg-body">
          <span class="lg-meta">
            <span class="lg-type">{c.data.type}</span> · <span class="lg-project">{projectLogos[c.data.project] && <img src={projectLogos[c.data.project]} alt="" width="14" height="14" class="lg-logo" loading="lazy" />}{c.data.project}</span> · <span style={`color: ${statusColor[c.data.status] ?? "var(--color-fg-muted)"}`}>{statusLabel[c.data.status] ?? c.data.status}</span>
          </span>
          <a href={c.data.url} target="_blank" rel="noopener" class="lg-link">{c.data.title} ↗︎</a>
          <span class="lg-desc">{c.data.description}</span>
          <span class="lg-outcome">→ {c.data.outcome}</span>
        </span>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  /* Grid + spacing are contributions-specific; base ledger styles live in global.css */
  .ledger-head, .ledger-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 0 18px;
  }
  .ledger-row {
    padding-block: 0.9rem;
  }
  .lg-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-muted);
    padding-top: 0.25rem;
  }
  .lg-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .lg-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-fg-muted);
    text-transform: lowercase;
  }
  .lg-type { color: var(--color-cyan); }
  .lg-project { white-space: nowrap; }
  .lg-logo { display: inline-block; vertical-align: -2px; margin-right: 5px; border-radius: 3px; }
  .lg-desc {
    max-width: 62ch;
  }
  .lg-outcome {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-green);
  }
  @media (max-width: 560px) {
    .ledger-head { display: none; }
    .ledger-row { grid-template-columns: 1fr; }
    .lg-date { margin-bottom: 0.3rem; }
  }
</style>
